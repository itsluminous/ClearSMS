<?xml version="1.0" encoding="utf-8"?>
<!-- Foreground of the "New message" launcher shortcut: a plus glyph, the
     universal "create" mark Samsung Messages' reference uses too. Drawn on
     the 108x108 adaptive canvas, fully inside the 66dp safe zone (the arms
     span 36..72). Flat colours only (no gradients: VectorDrawable gradients
     need API 24 and would trigger the non-reproducible PNG rasterisation
     docs/publishing-fdroid.md describes). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:pathData="M54,36 V72" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:pathData="M36,54 H72" />
</vector>
