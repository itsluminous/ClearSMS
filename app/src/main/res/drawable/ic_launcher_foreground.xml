<?xml version="1.0" encoding="utf-8"?>
<!-- Original "clean SMS" mark for Clear SMS: an outlined message bubble with a
     soft tonal glow inside and three staggered, tidy message lines (the short
     accent line hints at categorization). All artwork stays inside the
     adaptive-icon safe zone: on the 108x108 canvas only the inner 66dp circle
     (radius 33 from center 54,54) is guaranteed visible after masking; the
     farthest point here (the bubble tail tip, incl. stroke) sits ~32.2 from
     center.

     Deliberately gradient-free, matching mipmap-anydpi/ic_launcher.xml: a
     VectorDrawable gradient requires API 24, so with minSdk 23 AGP silently
     rasterises this vector into six density PNGs as an API-23 fallback. Those
     PNGs are rendered through Java2D/ImageIO, whose byte output varies with
     the JDK build and host platform - it broke F-Droid's reproducible-build
     verification (see docs/publishing-fdroid.md). A flat low-alpha fill keeps
     the tonal wash without generating anything. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Soft tonal fill inside the bubble: flat low-alpha white. -->
    <path
        android:fillColor="#2EFFFFFF"
        android:pathData="M43,36 h22 a9,9 0 0 1 9,9 v12 a9,9 0 0 1 -9,9 H47 l-9.3,8.2 q-2.3,2 -3.7,-0.8 V45 a9,9 0 0 1 9,-9 z" />
    <!-- Bubble outline (stroke 7 on the 108 canvas ≈ 3.1dp at 48dp). -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M43,36 h22 a9,9 0 0 1 9,9 v12 a9,9 0 0 1 -9,9 H47 l-9.3,8.2 q-2.3,2 -3.7,-0.8 V45 a9,9 0 0 1 9,-9 z" />
    <!-- Three staggered "sorted message" lines: long, medium, short. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M42,44 h24" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M42,52 h17" />
    <!-- Shortest line in a light tint of the indigo seed (accent = categorized). -->
    <path
        android:strokeColor="#FFC5CAE9"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M42,60 h10" />
</vector>
