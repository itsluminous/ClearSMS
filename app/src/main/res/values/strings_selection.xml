<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Multi-select contextual bar -->
    <string name="selection_count">%1$d selected</string>
    <string name="action_select_all">Select all</string>
    <string name="action_exit_selection">Exit selection</string>
    <string name="action_more_options">More options</string>
    <string name="action_forward_message">Forward</string>
    <string name="action_share_message">Share</string>
    <string name="action_mark_read_unread">Mark read/unread</string>
    <string name="action_pin">Pin</string>
    <string name="action_unpin">Unpin</string>
    <string name="selection_selected">Selected</string>

    <!-- Bulk delete confirmations. Which body shows is decided in ONE place,
         ui/common/DeleteConfirmationText, from the recycle-bin setting:
         with the bin on (the default) the rows rest in the bin for 30 days
         and can be restored, so the "permanent" wording would be false;
         with the bin off they are deleted outright, including from the
         system SMS store. The "30 days" here must match
         UndoManager.BIN_RETENTION_MS (DeleteConfirmationTextTest). -->
    <string name="selection_delete_threads_title">Delete conversations?</string>
    <string name="selection_delete_threads_message">%1$d conversation(s) will be permanently deleted, including from the system SMS store. This can\'t be undone.</string>
    <string name="selection_delete_threads_to_bin_message">%1$d conversation(s) will move to the recycle bin. You can restore them for 30 days; until then they are also gone from the phone\'s SMS store.</string>
    <string name="selection_delete_messages_title">Delete messages?</string>
    <string name="selection_delete_messages_message">%1$d message(s) will be permanently deleted, including from the system SMS store. This can\'t be undone.</string>
    <string name="selection_delete_messages_to_bin_message">%1$d message(s) will move to the recycle bin. You can restore them for 30 days; until then they are also gone from the phone\'s SMS store.</string>

    <!-- Reply availability (RepliabilityText, GitHub #75). Each line says only
         what the app can know: a short code's acceptance is a guess ("may
         not"), an alphanumeric id is a phone-side limit (replies are addressed
         to numbers), and an empty or absurd address is simply not a
         destination. Never "this sender doesn't accept replies". -->
    <string name="conversation_short_code_may_not_reply">Short codes like this one may not accept replies</string>
    <string name="conversation_reply_anyway">Reply anyway</string>
    <string name="conversation_reply_needs_number">Replies can only be sent to a number, not to a sender name like this</string>
    <string name="conversation_reply_no_address">This sender has no address a reply could be sent to</string>
</resources>
