    <!-- Privacy policy content -->
    <string name="privacy_ondevice_title">All processing happens on your device</string>
    <string name="privacy_ondevice_body">Categorization, OTP extraction and transaction parsing run entirely on this phone. Clear SMS has no servers and makes no network calls at runtime. Your messages are never uploaded, shared or analyzed anywhere else.</string>
    <string name="privacy_no_network_title">No analytics, no tracking, no ads</string>
    <string name="privacy_no_network_body">The app contains no analytics SDKs, crash reporters that transmit data, advertising frameworks or proprietary services.</string>
    <string name="privacy_backups_title">Backups are yours</string>
    <string name="privacy_backups_body">Backups are plain local files saved where you choose. They are never sent anywhere automatically.</string>
    <string name="privacy_rules_title">Transparent rules</string>
    <string name="privacy_rules_body">Every categorization rule is human-readable JSON you can inspect, edit, export and contribute back to the community. Sharing rules with the developer is always an explicit action that uses your email app.</string>

