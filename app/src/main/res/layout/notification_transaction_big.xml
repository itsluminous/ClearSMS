<?xml version="1.0" encoding="utf-8"?><!--
    Expanded transaction notification content: same colored amount and
    compact detail line as the collapsed view, plus the full original SMS
    body (the BigTextStyle equivalent for the custom layout).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/transaction_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="− ₹1,299"
        tools:textColor="@color/amount_debit" />

    <TextView
        android:id="@+id/transaction_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Line2"
        tools:text="Swiggy · A/c 2863 · HDFC Bank" />

    <TextView
        android:id="@+id/transaction_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.Compat.Notification"
        tools:text="Rs.1,299.00 debited from a/c **2863 on 27-07-26 to Swiggy. Avl bal Rs.12,430.00" />
</LinearLayout>
