<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SMS functionality requires telephony hardware. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="true" />

    <!-- Permissions required by a default SMS app (REQUIREMENTS §1.2) -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.WRITE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Required by WorkManager: the expedited InitialSyncWorker runs as a
         foreground service on API < 31 (see getForegroundInfo). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Optional: exact alarms for bill payment reminders -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- allowBackup is deliberately FALSE: the database holds the user's
         entire SMS history, so Android auto-backup / device-to-device
         transfer would be an exfiltration path. Backups are explicit,
         user-initiated exports only. With backup disabled no
         dataExtractionRules / fullBackupContent config is needed. -->
    <application
        android:name=".ClearSmsApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClearSms">

        <!-- Default SMS app requirement #1: an activity handling SEND/SENDTO
             for sms/smsto/mms/mmsto schemes. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
            <!-- Internal deep links used by notification tap actions. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="clearsms" />
            </intent-filter>
            <!-- Inbound share target: text shared from ANY app lands in the
                 new-conversation screen prefilled (EXTRA_TEXT only, never
                 auto-sent; attachments are ignored - no MMS compose yet).
                 Distinct from the sms-scheme SEND filter above, which
                 requires a data URI and so never matches a plain share. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Default SMS app requirement #2: SMS_DELIVER receiver. -->
        <receiver
            android:name=".receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- Default SMS app requirement #3: WAP_PUSH_DELIVER receiver for MMS. -->
        <receiver
            android:name=".receiver.MmsWapPushReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Default SMS app requirement #4: RESPOND_VIA_MESSAGE service. -->
        <service
            android:name=".service.HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- Re-schedules reminders, scheduled sends and periodic work after a
             device reboot or wall-clock/timezone change. Exported is required
             to receive BOOT_COMPLETED; safe because all three actions are
             protected broadcasts only the system can send, and onReceive
             ignores every other action. -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- AlarmManager target for scheduled message sends. NOT exported:
             only our own PendingIntents may trigger a send. -->
        <receiver
            android:name=".receiver.ScheduledSendReceiver"
            android:exported="false" />

        <!-- PendingIntent target for SMS sent / delivery reports. -->
        <receiver
            android:name=".receiver.SmsSentReceiver"
            android:exported="false" />

        <!-- PendingIntent target for MMS download results (see
             SystemMmsDownloader). NOT exported: only our own PendingIntents
             may report a download outcome. -->
        <receiver
            android:name=".receiver.MmsDownloadReceiver"
            android:exported="false" />

        <!-- Serves filesDir/mms/ only (see @xml/mms_file_paths): the staging
             file the platform MMS service writes a downloaded PDU into, and
             stored attachments handed to viewers/share targets via per-URI
             grants. Not exported; access is grant-based. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/mms_file_paths" />
        </provider>

        <!-- ================================================================
             Platform-stage additions (not part of the default-SMS-app
             contract): notification action handlers and reminder alarms.
             ================================================================ -->

        <!-- Copy / Share / Delete actions on OTP notifications. -->
        <receiver
            android:name=".notification.OtpActionReceiver"
            android:exported="false" />

        <!-- Mark read / Delete / inline Reply actions on message and
             transaction notifications. NOT exported: a third-party app must
             not be able to spoof a delete or mark-read broadcast. -->
        <receiver
            android:name=".notification.MessageActionReceiver"
            android:exported="false" />

        <!-- AlarmManager target for bill-due reminders. -->
        <receiver
            android:name=".receiver.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- WorkManager: on-demand initialization. The default initializer is
             removed because ClearSmsApplication implements Configuration.Provider
             (HiltWorkerFactory). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
