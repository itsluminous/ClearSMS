{
  "version": "1.0",
  "rules": [
    {
      "id": "hbl-otp-01",
      "name": "HBL OTP (card, online transaction, TPIN)",
      "priority": 350,
      "match": {
        "sender_pattern": "(?i)^1?4250$|HBL",
        "body_pattern": "(?i)\\b(\\d{4,8})\\s+is\\s+your\\s+(?:OTP|On\\s+Time\\s+Password)"
      },
      "action": {
        "category": "otp",
        "extract": {
          "otp_code": "$1",
          "bank": "HBL"
        },
        "notification": "otp_popup"
      },
      "contributed_by": "mzaeemkhan",
      "created_at": "2026-10-25T00:00:00Z"
    },
    {
      "id": "hbl-service-notice-01",
      "name": "HBL account / card / cheque book service notice",
      "priority": 150,
      "match": {
        "sender_pattern": "(?i)^1?4250$|HBL",
        "body_pattern": "(?i)\\b(?:cheque\\s+book|has\\s+been\\s+(?:successfully\\s+)?activated|TPIN\\s+has\\s+been|RAAST\\s+ID|CNIC\\s+expiry|successfully\\s+registered|bill\\s+payment\\s+request\\s+has\\s+been\\s+processed|Direct\\s+Transfer\\s+service)",
        "guards_none": [
          "otp_mention"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "bank_alert",
        "extract": {
          "bank": "HBL"
        }
      },
      "contributed_by": "mzaeemkhan",
      "created_at": "2026-10-25T00:00:00Z"
    }
  ]
}
