{
  "version": "1.0",
  "rules": [
    {
      "id": "vn-flight-schedule-change-01",
      "name": "Flight Schedule Change Alert",
      "priority": 280,
      "match": {
        "sender_pattern": "(?i)(?:TRAVELOKA|VTRAirlines)",
        "body_pattern": "(?i)(?:khởi\\s+hành\\s+sớm|THAY\\s+DOI|Chuyen\\s+bay)[\\s\\S]{0,60}?(?:Xem:|HK|ly\\s+do)"
      },
      "action": {
        "category": "important",
        "sub_category": "travel"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-10-06T00:00:00Z"
    },
    {
      "id": "vn-travel-account-notice-01",
      "name": "Travel Account Security Notification",
      "priority": 240,
      "match": {
        "sender_pattern": "(?i)TRAVELOKA",
        "body_pattern": "(?i)Traveloka\\s+thong\\s+bao",
        "guards_none": [
          "otp_mention"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "general"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-10-06T00:00:00Z"
    }
  ]
}
