{
  "version": "1.0",
  "rules": [
    {
      "id": "vn-generali-insurance-due-01",
      "name": "Generali Insurance Premium Due Reminder",
      "priority": 300,
      "match": {
        "sender_pattern": "(?i)Generali-VN",
        "body_pattern": "(?i)dong\\s+phi\\s+BH\\s+([\\d.,]+)\\s*VND\\s+cho\\s+HD\\s+(\\d+)"
      },
      "action": {
        "category": "important",
        "sub_category": "bill",
        "extract": {
          "amount": "$1",
          "account_last4": "$2",
          "biller": "Generali"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-10-06T00:00:00Z"
    },
    {
      "id": "vn-generali-insurance-notice-01",
      "name": "Generali Policy Status Notification",
      "priority": 250,
      "match": {
        "sender_pattern": "(?i)Generali-VN",
        "guards_none": [
          "otp_mention"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "general"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-10-06T00:00:00Z"
    },
    {
      "id": "vn-service-account-notice-01",
      "name": "App Account Lifecycle Notification",
      "priority": 200,
      "match": {
        "sender_pattern": "(?i)(?:ShopBack|GOTIT\\.VN|Mediplus)",
        "body_pattern": "(?i)(?:t[aà]i\\s+kho[aả]n|thong\\s+tin|c[aậ]p\\s+nh[aậ]t)"
      },
      "action": {
        "category": "important",
        "sub_category": "general"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-10-06T00:00:00Z"
    }
  ]
}
