{
  "version": "1.0",
  "rules": [
    {
      "id": "bidv-debit-01",
      "name": "BIDV Account Debit Transaction",
      "priority": 300,
      "match": {
        "sender_pattern": "(?i)BIDV",
        "body_must_contain": [
          "tai BIDV",
          "-"
        ],
        "body_pattern": "(?i)TK\\s+[\\d*Xx]*?(\\d{4})\\s+tai\\s+BIDV\\s+-([\\d.,]+)\\s*VND",
        "guards_none": [
          "otp_mention"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "account_last4": "$1",
          "amount": "$2",
          "type": "debit",
          "bank": "BIDV Bank"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-10-06T00:00:00Z"
    },
    {
      "id": "bidv-credit-01",
      "name": "BIDV Account Credit Transaction",
      "priority": 300,
      "match": {
        "sender_pattern": "(?i)BIDV",
        "body_must_contain": [
          "tai BIDV",
          "+"
        ],
        "body_pattern": "(?i)TK\\s+[\\d*Xx]*?(\\d{4})\\s+tai\\s+BIDV\\s+\\+([\\d.,]+)\\s*VND",
        "guards_none": [
          "otp_mention"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "account_last4": "$1",
          "amount": "$2",
          "type": "credit",
          "bank": "BIDV Bank"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-10-06T00:00:00Z"
    },
    {
      "id": "bidv-otp-01",
      "name": "BIDV Transaction Verification OTP",
      "priority": 350,
      "match": {
        "sender_pattern": "(?i)BIDV",
        "body_pattern": "(?i)nhap\\s+OTP\\s+(\\d{4,8})"
      },
      "action": {
        "category": "otp",
        "extract": {
          "otp_code": "$1"
        },
        "notification": "otp_popup"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-10-06T00:00:00Z"
    },
    {
      "id": "bidv-otp-02",
      "name": "BIDV SmartBanking Login OTP",
      "priority": 350,
      "match": {
        "sender_pattern": "(?i)BIDV",
        "body_pattern": "(?i)SmartBanking[\\s\\S]{0,50}?nhap\\s+(\\d{4,8})\\s+de\\s+xac\\s+thuc"
      },
      "action": {
        "category": "otp",
        "extract": {
          "otp_code": "$1"
        },
        "notification": "otp_popup"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-10-06T00:00:00Z"
    }
  ]
}
