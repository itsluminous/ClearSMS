{
  "version": "1.0",
  "rules": [
    {
      "id": "paytm-wallet-paid-01",
      "name": "Paytm Wallet Payment To Merchant",
      "priority": 320,
      "match": {
        "sender_pattern": "(?i)(?:IPAYTM|PYTMB|PAYTM)",
        "body_pattern": "(?i)paid\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+to\\s+([^\\n]{1,40}?)\\s+(?:with\\s+Paytm\\s+Ref|from\\s+Paytm\\s+(?:Balance|Payments\\s+Bank\\s+Wallet)|on\\s+[A-Z][a-z]{2}\\s+\\d)",
        "guards_none": [
          "otp_mention"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1",
          "merchant": "$2",
          "type": "debit",
          "bank": "Paytm"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "paytm-link-otp-01",
      "name": "Paytm Account-Link OTP In App Notice",
      "priority": 318,
      "match": {
        "sender_pattern": "(?i)(?:IPAYTM|PYTMB|PAYTM)",
        "body_pattern": "(?i)OTP\\s+to\\s+link\\s+your\\s+Paytm\\s+account\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "general"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-08-12T00:00:00Z"
    },
    {
      "id": "paytm-movies-ticket-01",
      "name": "Paytm Movies Ticket Details",
      "priority": 317,
      "match": {
        "sender_pattern": "(?i)(?:IPAYTM|PYTMB|PAYTM)",
        "body_pattern": "(?i)Paytm\\s+Movies\\s+ticket\\s+details"
      },
      "action": {
        "category": "important",
        "sub_category": "general"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-08-12T00:00:00Z"
    }
  ]
}
