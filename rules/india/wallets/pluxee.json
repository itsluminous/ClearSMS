{
  "version": "1.0",
  "rules": [
    {
      "id": "pluxee-debit-01",
      "name": "Pluxee Meal Card Spend",
      "priority": 300,
      "match": {
        "sender_pattern": "(?i)(?:PLUXEE|SODEXO)",
        "body_pattern": "(?i)(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+spent\\s+from"
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1",
          "type": "debit"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "pluxee-credit-01",
      "name": "Pluxee Wallet Credit",
      "priority": 299,
      "match": {
        "sender_pattern": "(?i)(?:PLUXEE|SODEXO)",
        "body_pattern": "(?i)(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+is\\s+credited\\s+in\\s+your"
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1",
          "type": "credit"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "pluxee-bill-01",
      "name": "Pluxee Reimbursement Bill Uploaded",
      "priority": 298,
      "match": {
        "sender_pattern": "(?i)(?:PLUXEE|SODEXO)",
        "body_pattern": "(?i)reimbursements?\\s+bill\\s+for\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)"
      },
      "action": {
        "category": "important",
        "sub_category": "bill",
        "extract": {
          "amount": "$1"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "pluxee-claim-01",
      "name": "Pluxee Reimbursement Claim Update",
      "priority": 297,
      "match": {
        "sender_pattern": "(?i)(?:PLUXEE|SODEXO)",
        "body_pattern": "(?i)reimbursement\\s+claim\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)"
      },
      "action": {
        "category": "important",
        "sub_category": "bank_alert",
        "extract": {
          "amount": "$1"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "pluxee-info-01",
      "name": "Pluxee Service Update",
      "priority": 200,
      "match": {
        "sender_pattern": "(?i)(?:PLUXEE|SODEXO)"
      },
      "action": {
        "category": "important"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "sodexo-meal-load-01",
      "name": "Sodexo Meal Card Load (Credit + Balance)",
      "priority": 300,
      "match": {
        "sender_pattern": "(?i)SODEXO|PLUXEE",
        "body_pattern": "(?i)Sodexo\\s+Card\\s+has\\s+been\\s+successfully\\s+loaded\\s+with\\s+Rs\\.?\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+towards\\s+Meal\\s+A/c[\\s\\S]{0,40}?Meal\\s+A/c\\s+bal\\s+is\\s+Rs\\.?\\s*([\\d,]+(?:\\.\\d{1,2})?)",
        "guards_none": [
          "otp_mention"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1",
          "balance": "$2",
          "type": "credit",
          "bank": "Sodexo"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "sodexo-meal-spend-01",
      "name": "Sodexo Meal Card Spend (Debit + Balance)",
      "priority": 300,
      "match": {
        "sender_pattern": "(?i)SODEXO|PLUXEE",
        "body_pattern": "(?i)Rs\\.?\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+was\\s+spent\\s+from\\s+your\\s+Meal\\s+A/c\\W{0,2}[Xx*]*(\\d{3,4})[\\s\\S]{0,80}?Meal\\s+A/c\\s+bal\\s+is\\s+Rs\\.?\\s*([\\d,]+(?:\\.\\d{1,2})?)",
        "guards_none": [
          "otp_mention"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1",
          "account_last4": "$2",
          "balance": "$3",
          "type": "debit",
          "bank": "Sodexo"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    }
  ]
}
