{
  "version": "1.0",
  "rules": [
    {
      "id": "cred-cc-payment-01",
      "name": "CRED Credit Card Payment Received",
      "priority": 315,
      "match": {
        "sender_pattern": "(?i)CRED",
        "body_pattern": "(?i)payment\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+was\\s+received\\s+for\\s+your\\s+([A-Za-z ]{2,20}?)\\s+credit\\s+card\\b[\\s\\S]{0,90}?CRED\\s+coins",
        "guards_none": [
          "otp_mention"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1",
          "bank": "$2",
          "type": "credit"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    }
  ]
}
