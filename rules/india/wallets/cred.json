{
  "version": "1.0",
  "rules": [
    {
      "id": "cred-cc-payment-01",
      "name": "CRED Credit Card Payment Received",
      "priority": 315,
      "match": {
        "sender_pattern": "(?i)CRED",
        "body_pattern": "(?i)payment\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+was\\s+received\\s+for\\s+your\\s+([A-Za-z ]{2,20}?)\\s+credit\\s+card\\b[\\s\\S]{0,90}?CRED\\s+coins",
        "guards_none": [
          "otp_mention"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1",
          "bank": "$2",
          "type": "credit"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "cred-bill-generated-01",
      "name": "CRED Credit Card Bill Generated",
      "priority": 314,
      "match": {
        "sender_pattern": "(?i)CRED",
        "body_pattern": "(?i)credit\\s+card\\s+bill\\s+for\\s+([A-Za-z][A-Za-z ]{2,24}?)\\s+[Xx*]{2,6}-?(\\d{3,4})\\s+has\\s+been\\s+generated[\\s\\S]{0,40}?Total\\s+amount\\s*:\\s*(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)[\\s\\S]{0,30}?Due\\s+date\\s*:\\s*([A-Za-z]{3,9}\\s+\\d{1,2},?\\s+\\d{2,4}|\\d{1,2}[-/][A-Za-z0-9]{1,3}[-/]\\d{2,4})"
      },
      "action": {
        "category": "important",
        "sub_category": "bill",
        "extract": {
          "bank": "$1",
          "account_last4": "$2",
          "total_due": "$3",
          "due_date": "$4"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-08-06T00:00:00Z"
    }
  ]
}
