{
  "version": "1.0",
  "rules": [
    {
      "id": "electricity-bill-01",
      "name": "Electricity Bill Ready",
      "priority": 155,
      "match": {
        "body_pattern": "(?i)electricity\\s+bill[\\s\\S]{0,60}?(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)"
      },
      "action": {
        "category": "important",
        "sub_category": "bill",
        "extract": {
          "amount": "$1"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "utility-consumer-bill-01",
      "name": "Utility Bill by Consumer Number",
      "priority": 150,
      "match": {
        "body_pattern": "(?i)bill\\s+for[\\s\\S]{0,40}?consumer\\s+no[\\s\\S]{0,40}?(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)"
      },
      "action": {
        "category": "important",
        "sub_category": "bill",
        "extract": {
          "amount": "$1"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    }
  ]
}
