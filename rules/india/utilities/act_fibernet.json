{
  "version": "1.0",
  "rules": [
    {
      "id": "act-bill-01",
      "name": "ACT Fibernet Bill",
      "priority": 250,
      "match": {
        "sender_pattern": "(?i)(?:ACTFBN|ACTCORP|ACTGRP|ACTBRD)",
        "body_pattern": "(?i)bill\\s+for[\\s\\S]{0,30}?A/C[\\s\\S]{0,30}?(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)"
      },
      "action": {
        "category": "important",
        "sub_category": "bill",
        "extract": {
          "amount": "$1"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "act-bill-due-01",
      "name": "ACT Fibernet Broadband Bill Due",
      "priority": 252,
      "match": {
        "sender_pattern": "(?i)(?:ACTFBN|ACTCORP|ACTGRP|ACTBRD|AIRBIL|AIRTEL)",
        "body_pattern": "(?i)ACT\\s+Fibernet\\s+Broadband\\s+bill\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)[^\\n]{0,60}?\\bis\\s+due\\s+on\\s+(\\d{1,2}-[A-Za-z]{3}-\\d{2,4})"
      },
      "action": {
        "category": "important",
        "sub_category": "bill",
        "extract": {
          "total_due": "$1",
          "due_date": "$2"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-30T00:00:00Z"
    },
    {
      "id": "act-receipt-01",
      "name": "ACT Fibernet Payment Receipt",
      "priority": 245,
      "match": {
        "sender_pattern": "(?i)(?:ACTFBN|ACTCORP|ACTGRP|ACTBRD)",
        "body_pattern": "(?i)receipt\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)"
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "act-otp-01",
      "name": "ACT Fibernet OTP",
      "priority": 330,
      "match": {
        "sender_pattern": "(?i)(?:ACTFBN|ACTCORP|ACTGRP|ACTBRD)",
        "body_pattern": "(?i)Your\\s+OTP\\s+is\\s*:?\\s*(\\d{4,8})\\b"
      },
      "action": {
        "category": "otp",
        "sub_category": "otp",
        "extract": {
          "otp_code": "$1"
        },
        "notification": "otp_popup"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    }
  ]
}
