{
  "version": "1.0",
  "rules": [
    {
      "id": "nbhood-invoice-01",
      "name": "Society Maintenance Invoice",
      "priority": 250,
      "match": {
        "sender_pattern": "(?i)(?:NBHOOD|NOBROKER)",
        "body_pattern": "(?i)invoice\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)"
      },
      "action": {
        "category": "important",
        "sub_category": "bill",
        "extract": {
          "amount": "$1"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    }
  ]
}
