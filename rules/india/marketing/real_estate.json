{
  "version": "1.0",
  "rules": [
    {
      "id": "thrsxt-realestate-01",
      "name": "Real Estate Blast (THRSXT)",
      "priority": 200,
      "match": {
        "sender_pattern": "(?i)THRSXT",
        "body_pattern": "(?i)(?:BHK|apartment|plot|Lacs|Call\\s+Now)"
      },
      "action": {
        "category": "promotional",
        "sub_category": "offer"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "shriram-realestate-01",
