{
  "version": "1.0",
  "rules": [
    {
      "id": "icicipru-otp-01",
      "name": "ICICI Pru Life Login OTP",
      "priority": 330,
      "match": {
        "sender_pattern": "(?i)(?:ICICIP|IPRULI)",
        "body_pattern": "(?i)(\\d{4,8})\\s+is\\s+the\\s+One[\\s-]?Time\\s+Password\\s+to\\s+login\\s+to\\s+your\\s+ICICI\\s+Pru"
      },
      "action": {
        "category": "otp",
        "sub_category": "otp",
        "extract": {
          "otp_code": "$1"
        },
        "notification": "otp_popup"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "icicipru-premium-01",
      "name": "ICICI Pru Premium Due Reminder",
      "priority": 300,
      "match": {
        "sender_pattern": "(?i)(?:ICICIP|IPRULI)",
        "body_pattern": "(?i)premium\\s+due\\s+on\\s+(\\d{1,2}-[A-Za-z]{3}-\\d{2,4})\\s+for\\s+your\\s+ICICIPru\\s+policy[\\s\\S]{0,80}?of\\s+Rs\\.?\\s*([\\d,]+(?:\\.\\d{1,2})?)"
      },
      "action": {
        "category": "important",
        "sub_category": "bill",
        "extract": {
          "due_date": "$1",
          "amount": "$2"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    }
  ]
}
