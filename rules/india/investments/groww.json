{
  "version": "1.0",
  "rules": [
    {
      "id": "groww-settlement-credit-01",
      "name": "Groww Monthly Settlement Credited (UTR)",
      "priority": 315,
      "match": {
        "sender_pattern": "(?i)GROWW",
        "body_pattern": "(?i)\\bsettlement\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+(?:has\\s+been\\s+)?credited\\s+to\\s+your\\s+([A-Za-z ]{2,30}?)\\s+a\\/?c(?:count)?\\s+[Xx*]*(\\d{4})\\b[^\\n]{0,60}?\\bUTR\\b[:\\s]*([A-Za-z0-9]{8,22})\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1",
          "bank": "$2",
          "account_last4": "$3",
          "reference": "$4",
          "type": "credit"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-08-18T00:00:00Z"
    }
  ]
}
