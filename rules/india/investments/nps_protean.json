{
  "version": "1.0",
  "rules": [
    {
      "id": "nps-contribution-01",
      "name": "NPS Contribution Units Credited",
      "priority": 320,
      "match": {
        "sender_pattern": "(?i)(?:PTNNPS|PROTEA|Protean|NSDLNP|NSDLPN|CRANPS)",
        "body_pattern": "(?i)PRAN\\s+[A-Zx*]{0,8}(\\d{3,4})\\s*:\\s*Units\\s+for\\s+\\([A-Z]{3}-\\d{4}\\)\\s+contribution\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+credited"
      },
      "action": {
        "category": "important",
        "sub_category": "investment",
        "extract": {
          "amount": "$2",
          "type": "credit",
          "merchant": "NPS",
          "account_last4": "$1",
          "bank": "Protean NPS"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "nps-balance-01",
      "name": "NPS Investment Value Statement",
      "priority": 318,
      "match": {
        "sender_pattern": "(?i)(?:PTNNPS|PROTEA|Protean|NSDLNP|NSDLPN|CRANPS)",
        "body_pattern": "(?i)Investment\\s+value\\s+in\\s+(?:NPS\\s+)?Tier\\s+I{1,2}\\s+\\(PRAN[\\s-]?[A-Za-zXx*]{0,10}?(\\d{3,4})\\)\\s+as\\s+on\\s+[0-9./-]{6,10}\\s+is\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)"
      },
      "action": {
        "category": "important",
        "sub_category": "investment",
        "extract": {
          "balance": "$2",
          "account_last4": "$1",
          "bank": "Protean NPS"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "nps-contribution-credited-01",
      "name": "NPS Contribution Credited (account shape)",
      "priority": 316,
      "match": {
        "sender_pattern": "(?i)(?:PTNNPS|PROTEA|Protean|NSDLNP|NSDLPN|CRANPS)",
        "body_pattern": "(?i)Contribution\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+credited\\s+to\\s+your\\s+NPS\\s+account"
      },
      "action": {
        "category": "important",
        "sub_category": "investment",
        "extract": {
          "amount": "$1",
          "type": "credit",
          "merchant": "NPS",
          "bank": "Protean NPS"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    }
  ]
}
