{
  "version": "1.0",
  "rules": [
    {
      "id": "abc-otp-01",
      "name": "Aditya Birla Capital Login OTP",
      "priority": 330,
      "match": {
        "sender_pattern": "(?i)ABCSER",
        "body_pattern": "(?i)(\\d{4,8})\\s+is\\s+the\\s+One[\\s-]?Time\\s+Password[\\s\\S]{0,60}?Aditya\\s+Birla"
      },
      "action": {
        "category": "otp",
        "sub_category": "otp",
        "extract": {
          "otp_code": "$1"
        },
        "notification": "otp_popup"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    }
  ]
}
