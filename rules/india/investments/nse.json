{
  "version": "1.0",
  "rules": [
    {
      "id": "nse-traded-value-01",
      "name": "Exchange Traded Value Notice",
      "priority": 280,
      "match": {
        "body_pattern": "(?i)\\byour\\s+traded\\s+value\\s+for\\s+\\d{1,2}-[A-Z]{3}-\\d{2,4}\\b"
      },
      "action": {
        "category": "informational",
        "sub_category": "investment"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "nse-broker-balance-01",
      "name": "Broker Fund/Securities Balance Statement",
      "priority": 280,
      "match": {
        "body_pattern": "(?i)reported\\s+your\\s+Fund\\s+bal(?:ance)?\\b[\\s\\S]{0,80}?\\bSecurities\\s+bal(?:ance)?\\b"
      },
      "action": {
        "category": "informational",
        "sub_category": "investment"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    }
  ]
}
