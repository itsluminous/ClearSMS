{
  "version": "1.0",
  "rules": [
    {
      "id": "kfncra-otp-01",
      "name": "NPS Online Login OTP",
      "priority": 330,
      "match": {
        "sender_pattern": "(?i)KFNCRA",
        "body_pattern": "(?i)OTP\\s+for\\s+online\\s+Login\\s+under\\s+NPS\\s+is\\s+(\\d{4,8})"
      },
      "action": {
        "category": "otp",
        "sub_category": "otp",
        "extract": {
          "otp_code": "$1"
        },
        "notification": "otp_popup"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "kfncra-contrib-01",
      "name": "NPS Contribution Update",
      "priority": 300,
      "match": {
        "sender_pattern": "(?i)KFNCRA",
        "body_pattern": "(?i)contribution\\s+of\\s+Rs\\.?\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+(?:has\\s+been\\s+credited|for\\s+PRAN)"
      },
      "action": {
        "category": "important",
        "sub_category": "investment",
        "extract": {
          "amount": "$1"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "kfncra-fund-01",
      "name": "NPS Fund Confirmation",
      "priority": 298,
      "match": {
        "sender_pattern": "(?i)KFNCRA",
        "body_pattern": "(?i)fund\\s+confirmation\\s+of\\s+Rs\\.?\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+for\\s+investment\\s+in\\s+PRAN"
      },
      "action": {
        "category": "important",
        "sub_category": "investment",
        "extract": {
          "amount": "$1"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "kfncra-value-01",
      "name": "NPS Investment Valuation",
      "priority": 295,
      "match": {
        "sender_pattern": "(?i)KFNCRA",
        "body_pattern": "(?i)Value\\s+of\\s+investments\\s+in\\s+your\\s+PRAN[\\s\\S]{0,60}?is\\s+Rs\\.?\\s*([\\d,]+(?:\\.\\d{1,2})?)"
      },
      "action": {
        "category": "important",
        "sub_category": "investment",
        "extract": {
          "balance": "$1"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    }
  ]
}
