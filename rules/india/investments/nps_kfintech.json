{
  "version": "1.0",
  "rules": [
    {
      "id": "kfncra-otp-01",
      "name": "NPS Online Login OTP",
      "priority": 330,
      "match": {
        "sender_pattern": "(?i)KFNCRA",
        "body_pattern": "(?i)OTP\\s+for\\s+online\\s+Login\\s+under\\s+NPS\\s+is\\s+(\\d{4,8})"
      },
      "action": {
        "category": "otp",
        "sub_category": "otp",
        "extract": {
          "otp_code": "$1"
        },
        "notification": "otp_popup"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "kfncra-fund-01",
      "name": "NPS Fund Confirmation (contribution received)",
      "priority": 320,
      "match": {
        "sender_pattern": "(?i)KFNCRA",
        "body_pattern": "(?i)fund\\s+confirmation\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+for\\s+investment\\s+in\\s+PRAN\\s+[Xx*]{0,8}(\\d{3,4})"
      },
      "action": {
        "category": "important",
        "sub_category": "investment",
        "extract": {
          "amount": "$1",
          "type": "credit",
          "merchant": "NPS",
          "account_last4": "$2",
          "bank": "NPS"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "kfncra-contrib-01",
      "name": "NPS Units Credited (valuation update)",
      "priority": 318,
      "match": {
        "sender_pattern": "(?i)KFNCRA",
        "body_pattern": "(?i)contribution\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*[\\d,]+(?:\\.\\d{1,2})?\\s+has\\s+been\\s+credited\\s+to\\s+your\\s+NPS\\s+Tier\\s*-?\\s*I{1,2}\\s+a/c[\\s\\S]{0,80}?valuation\\s+of\\s+your\\s+Tier\\s*-?\\s*I{1,2}\\s+a/c\\s+is\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)"
      },
      "action": {
        "category": "important",
        "sub_category": "investment",
        "extract": {
          "balance": "$1",
          "bank": "NPS"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "kfncra-value-01",
      "name": "NPS Investment Valuation",
      "priority": 295,
      "match": {
        "sender_pattern": "(?i)KFNCRA",
        "body_pattern": "(?i)Value\\s+of\\s+investments\\s+in\\s+your\\s+PRAN\\s+[Xx*]{0,8}(\\d{3,4})\\s+Tier\\s*-?\\s*I{1,2}[\\s\\S]{0,40}?as\\s+on\\s+[0-9./-]{6,10}\\s+is\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)"
      },
      "action": {
        "category": "important",
        "sub_category": "investment",
        "extract": {
          "balance": "$2",
          "account_last4": "$1",
          "bank": "NPS"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    }
  ]
}
