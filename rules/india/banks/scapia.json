{
  "version": "1.0",
  "rules": [
    {
      "id": "scapia-txn-success-01",
      "name": "Scapia Federal Card Spend",
      "priority": 300,
      "match": {
        "sender_pattern": "(?i)FEDSCP",
        "body_pattern": "(?i)txn\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+at\\s+([^\\n]{1,60}?)\\s+on\\s+your\\s+(?:Scapia\\s+Federal|Federal\\s+Scapia)\\b[^\\n]{0,20}?\\bcredit\\s+card\\s+was\\s+successful",
        "guards_none": [
          "otp_mention"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1",
          "merchant": "$2",
          "type": "debit",
          "bank": "Scapia Federal"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-30T00:00:00Z"
    },
    {
      "id": "scapia-txn-declined-01",
      "name": "Scapia Federal Card Declined Transaction",
      "priority": 300,
      "match": {
        "sender_pattern": "(?i)FEDSCP",
        "body_pattern": "(?i)txn\\s+for\\s+(?:INR|Rs\\.?|\\u20b9)\\s*[\\d,]+(?:\\.\\d{1,2})?\\s+at\\s+[^\\n]{1,60}?\\s+on\\s+your\\s+(?:Scapia\\s+Federal|Federal\\s+Scapia)\\b[^\\n]{0,20}?\\bcredit\\s+card\\s+declined"
      },
      "action": {
        "category": "important",
        "sub_category": "bank_alert"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-30T00:00:00Z"
    },
    {
      "id": "scapia-card-statement-01",
      "name": "Scapia Federal Credit Card Statement",
      "priority": 300,
      "match": {
        "sender_pattern": "(?i)FEDSCP",
        "body_pattern": "(?i)(?:Scapia\\s+Federal|Federal\\s+Scapia)\\s+credit\\s+card\\s+statement\\s+for\\s+[A-Za-z]{3,9}[-\\s]\\d{4}[^\\n]{0,140}?\\bpay\\s+by\\s+(\\d{1,2}-\\d{1,2}-\\d{4})"
      },
      "action": {
        "category": "important",
        "sub_category": "bill",
        "extract": {
          "due_date": "$1",
          "bank": "Scapia Federal"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-30T00:00:00Z"
    },
    {
      "id": "scapia-card-notice-01",
      "name": "Scapia Federal Card Setting Notice",
      "priority": 290,
      "match": {
        "sender_pattern": "(?i)FEDSCP",
        "body_pattern": "(?i)\\b(?:enabled|disabled|reset)\\b[^\\n]{0,90}?\\b(?:Scapia\\s+Federal|Federal\\s+Scapia)\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "bank_alert"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-30T00:00:00Z"
    },
    {
      "id": "scapia-card-info-01",
      "name": "Scapia Federal Card Information",
      "priority": 200,
      "match": {
        "sender_pattern": "(?i)FEDSCP",
        "body_pattern": "(?i)\\bScapia\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "bank_alert"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-30T00:00:00Z"
    }
  ]
}
