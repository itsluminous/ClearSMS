    },
    {
      "id": "icici-cc-refund-02",
      "name": "ICICI Bank Credit Card Merchant Refund",
      "priority": 329,
      "match": {
        "sender_pattern": "(?i)ICICI",
        "body_pattern": "(?i)(\\S[^\\n]{0,35}?)\\s+refund\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+credited\\s+to\\s+(?:your\\s+)?ICICI\\s+Bank\\s+Credit\\s+Card\\s+[Xx*]*(\\d{2,4})"
