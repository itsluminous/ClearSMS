    },
    {
      "id": "icici-card-dispatch-01",
      "name": "ICICI Bank Card Dispatch/Delivery Update",
      "priority": 294,
      "match": {
        "sender_pattern": "(?i)ICICI",
        "body_pattern": "(?i)(?:delivered|out\\s+for\\s+delivery|dispatched):\\s*credit\\s+card\\b[\\s\\S]{0,60}?ICICI\\s+Bank\\s+Card"
      },
      "action": {
        "category": "important",
        "sub_category": "delivery",
        "extract": {
          "bank": "ICICI Bank"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    }
  ]
