      "match": {
        "sender_pattern": "(?i)ICICI",
        "body_pattern": "(?i)reversal\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+credited\\s+to\\s+(?:your\\s+)?ICICI\\s+Bank\\s+Credit\\s+Card\\s+[Xx*]*(\\d{2,4})"
      },
      "action": {
        "category": "important",
