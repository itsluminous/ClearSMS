      "name": "ICICI Bank Credit Card Credited/Refunded",
      "priority": 327,
      "match": {
        "sender_pattern": "(?i)ICICI",
        "body_pattern": "(?i)ICICI\\s+Bank\\s+Credit\\s+Card\\s+[Xx*]*(\\d{2,4})\\s+credited/refunded\\s+with\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)"
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
