    },
    {
      "id": "icici-otp-txn-01",
      "name": "ICICI Bank Card Transaction OTP",
      "priority": 330,
      "match": {
        "sender_pattern": "(?i)ICICI",
        "body_pattern": "(?i)(\\d{4,8})\\s+is\\s+One[- ]?Time\\s+Password\\s+for\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+transaction\\s+towards\\s+([^\\n]{1,40}?)\\s+using\\s+ICICI\\s+Bank"
      },
      "action": {
        "category": "otp",
        "sub_category": "otp",
        "extract": {
          "otp_code": "$1",
          "amount": "$2",
          "merchant": "$3",
          "bank": "ICICI Bank"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
