{
  "version": "1.0",
  "rules": [
    {
      "id": "icici-debit-01",
      "name": "ICICI Bank Account Debit",
      "priority": 300,
      "match": {
        "sender_pattern": "(?i)ICICI",
        "body_pattern": "(?i)ICICI\\s+Bank\\s+Acc(?:oun)?t\\s+[Xx*]*(\\d{3,4})\\s+(?:is\\s+)?debited\\s+(?:for|with)\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)",
        "body_must_not_contain": [
          "OTP",
          "otp"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "account_last4": "$1",
          "amount": "$2",
          "type": "debit",
          "bank": "ICICI Bank"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "icici-credit-01",
      "name": "ICICI Bank Credit Transaction",
      "priority": 300,
      "match": {
        "sender_pattern": "(?i)ICICI",
        "body_pattern": "(?i)ICICI\\s+Bank\\s+Acc(?:oun)?t\\s+[Xx*]*(\\d{3,4})\\s+(?:is\\s+)?credited\\s+with\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)",
        "body_must_not_contain": [
          "OTP",
          "otp"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "account_last4": "$1",
          "amount": "$2",
          "type": "credit",
          "bank": "ICICI Bank"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "icici-balance-01",
      "name": "ICICI Bank Balance Alert",
      "priority": 280,
      "match": {
        "sender_pattern": "(?i)ICICI",
        "body_pattern": "(?i)(?:avl|available)\\s+bal(?:ance)?\\s+(?:in|for)\\s+(?:your\\s+)?a/c\\s+(?:no\\.?\\s*)?[Xx*]*(\\d{3,4})[\\s\\S]{0,60}?is\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)",
        "body_must_not_contain": [
          "OTP",
          "otp"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "bank_alert",
        "extract": {
          "account_last4": "$1",
          "balance": "$2",
          "bank": "ICICI Bank"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "icici-card-bill-01",
      "name": "ICICI Bank Credit Card Bill Reminder",
      "priority": 260,
      "match": {
        "sender_pattern": "(?i)ICICI",
        "body_pattern": "(?i)(?:credit\\s+)?card\\s+(?:no\\.?\\s*)?(?:ending\\s+)?[Xx*]*(\\d{4})[\\s\\S]{0,100}?total\\s+(?:amt|amount)?\\s*due[\\s:]*(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)[\\s\\S]{0,80}?min(?:imum)?\\s+(?:amt|amount)?\\s*due[\\s:]*(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)[\\s\\S]{0,80}?(?:due\\s+by|pay\\s+by|by)\\s+(\\d{1,2}[-/\\s](?:[A-Za-z]{3}|\\d{1,2})[-/\\s]\\d{2,4})"
      },
      "action": {
        "category": "important",
        "sub_category": "bill",
        "extract": {
          "account_last4": "$1",
          "total_due": "$2",
          "min_due": "$3",
          "due_date": "$4",
          "bank": "ICICI Bank"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "icici-emi-01",
      "name": "ICICI Bank EMI Reminder",
      "priority": 250,
      "match": {
        "sender_pattern": "(?i)ICICI",
        "body_pattern": "(?i)EMI\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)[\\s\\S]{0,80}?due\\s+on\\s+(\\d{1,2}[-/\\s](?:[A-Za-z]{3}|\\d{1,2})[-/\\s]\\d{2,4})"
      },
      "action": {
        "category": "important",
        "sub_category": "bill",
        "extract": {
          "amount": "$1",
          "due_date": "$2",
          "bank": "ICICI Bank"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "icici-card-spent-01",
      "name": "ICICI Bank Card Spend At Merchant",
      "priority": 325,
      "match": {
        "sender_pattern": "(?i)ICICI",
        "body_pattern": "(?i)(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+spent\\s+(?:using|on)\\s+ICICI\\s+Bank\\s+Card\\s+[Xx*]*(\\d{2,4})\\s+on\\s+\\S{5,12}\\s+(?:on|at)\\s+([^\\n]{1,40}?)\\.?\\s+Avl\\s+L",
        "body_must_not_contain": [
          "OTP",
          "otp"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1",
          "account_last4": "$2",
          "merchant": "$3",
          "type": "debit",
          "bank": "ICICI Bank"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "icici-card-debit-info-01",
      "name": "ICICI Bank Credit Card Debit With Info",
      "priority": 323,
      "match": {
        "sender_pattern": "(?i)ICICI",
        "body_pattern": "(?i)(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+is\\s+debited\\s+on\\s+ICICI\\s+Bank\\s+Credit\\s+Card\\s+[Xx*]*(\\d{2,4})[\\s\\S]{0,30}?Info:\\s*([^.\\n]{1,40})",
        "body_must_not_contain": [
          "OTP",
          "otp"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1",
          "account_last4": "$2",
          "merchant": "$3",
          "type": "debit",
          "bank": "ICICI Bank"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "icici-cc-stmt-01",
      "name": "ICICI Bank Credit Card Statement Due",
      "priority": 320,
      "match": {
        "sender_pattern": "(?i)ICICI",
        "body_pattern": "(?i)total\\s+due\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s*&\\s*min(?:imum)?\\s+due\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+(?:to\\s+be\\s+paid\\s+by|due\\s+by)\\s+([0-9A-Za-z-]{6,12})\\s+on\\s+ICICI\\s+Bank\\s+Credit\\s+Card\\s+[Xx*]*(\\d{2,4})"
      },
      "action": {
        "category": "important",
        "sub_category": "bill",
        "extract": {
          "total_due": "$1",
          "min_due": "$2",
          "due_date": "$3",
          "account_last4": "$4",
          "bank": "ICICI Bank"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "icici-cc-payment-01",
      "name": "ICICI Bank Credit Card Payment Received",
      "priority": 318,
      "match": {
        "sender_pattern": "(?i)ICICI",
        "body_pattern": "(?i)payment\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+has\\s+been\\s+received\\s+(?:towards|on)\\s+(?:your\\s+)?ICICI\\s+Bank\\s+Credit\\s+Card\\s+[Xx*]*(\\d{2,4})",
        "body_must_not_contain": [
          "OTP",
          "otp"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1",
