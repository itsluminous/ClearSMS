        "sender_pattern": "(?i)ICICI",
        "body_pattern": "(?i)refund\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+from\\s+([^\\n]{1,40}?)\\s+has\\s+been\\s+credited\\s+to\\s+your\\s+ICICI\\s+Bank\\s+Credit\\s+Card\\s+[Xx*]*(\\d{2,4})"
