{
  "version": "1.0",
  "rules": [
    {
      "id": "upi-mandate-created-01",
      "name": "UPI Autopay Mandate Created",
      "priority": 285,
      "match": {
        "body_pattern": "(?i)\\bmandate\\b[\\s\\S]{0,60}?\\bsuccessfully\\s+(?:created|modified)\\b|\\bmandate\\s+(?:has\\s+been|is|was)\\s+(?:created|modified)\\b"
      },
      "action": {
        "category": "informational",
        "sub_category": "bank_alert"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "upi-mandate-cancelled-01",
      "name": "UPI Autopay Mandate / Scheduled Payment Cancelled",
      "priority": 285,
      "match": {
        "body_pattern": "(?i)\\bsuccessfully\\s+cancelled\\s+the\\s+scheduled\\b[\\s\\S]{0,60}?\\bpayment\\b|\\bmandate\\b[\\s\\S]{0,60}?\\bsuccessfully\\s+(?:cancelled|revoked)\\b|\\bmandate\\s+(?:has\\s+been|is|was)\\s+(?:cancelled|revoked)\\b"
      },
      "action": {
        "category": "informational",
        "sub_category": "bank_alert"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    }
  ]
}
