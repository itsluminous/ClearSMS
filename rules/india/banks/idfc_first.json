    },
    {
      "id": "idfc-first-cc-payment-01",
      "name": "IDFC FIRST Bank Credit Card Payment Received",
      "priority": 315,
      "match": {
        "sender_pattern": "(?i)(?:IDFCFB|IDFCBK|IDFC)",
        "body_pattern": "(?i)(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+was\\s+received\\s+for\\s+your\\s+IDFC\\s+FIRST\\s+Bank\\s+Credit\\s+Card\\s+ending\\s+[Xx*]*(\\d{2,4})",
        "guards_none": [
          "otp_mention"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1",
          "account_last4": "$2",
          "type": "credit",
          "bank": "IDFC FIRST Bank"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "idfc-first-estatement-01",
      "name": "IDFC FIRST Bank Credit Card Statement",
      "priority": 310,
      "match": {
        "sender_pattern": "(?i)(?:IDFCFB|IDFCBK|IDFC)",
        "body_pattern": "(?i)Credit\\s+Card\\s+[Xx*]*(\\d{2,4})\\s*(?:bill\\s+due\\s+by|is\\s+here\\.?\\s*Due\\s+by)\\s+([0-9A-Za-z, -]{6,20}?)\\s*Total\\s+Due:\\s*(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+Min\\s+Due:\\s*(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)"
      },
      "action": {
        "category": "important",
        "sub_category": "bill",
        "extract": {
          "account_last4": "$1",
          "due_date": "$2",
          "total_due": "$3",
          "min_due": "$4",
          "bank": "IDFC FIRST Bank"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    }
  ]
}
