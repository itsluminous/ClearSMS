{
  "version": "1.0",
  "rules": [
    {
      "id": "hsbc-credit-01",
      "name": "HSBC Account Credit With Narration",
      "priority": 320,
      "match": {
        "sender_pattern": "(?i)HSBC",
        "body_pattern": "(?i)your\\s+HSBC\\s+A/c\\s+[\\dXx*-]*(\\d{3,4})\\s+has\\s+been\\s+credited\\s+with\\s+INR\\s*([\\d,]+(?:\\.\\d{1,2})?)\\+?\\s+on\\s+\\S{4,8}\\s+as\\s+([^\\n.]{1,40}?)\\s*\\.[\\s\\S]{0,30}?available\\s+Bal\\s+is\\s+([\\d,]+(?:\\.\\d{1,2})?)",
        "guards_none": [
          "otp_mention"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "account_last4": "$1",
          "amount": "$2",
          "merchant": "$3",
          "balance": "$4",
          "type": "credit",
          "bank": "HSBC"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    }
  ]
}
