{
  "version": "1.0",
  "rules": [
    {
      "id": "hdfc-debit-01",
      "name": "HDFC Bank Debit (Sent From A/C)",
      "priority": 300,
      "match": {
        "sender_pattern": "(?i)HDFC",
        "body_pattern": "(?i)sent\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+from\\s+HDFC\\s+Bank\\s+A/C\\s+[Xx*]*(\\d{3,4})",
        "body_must_not_contain": [
          "OTP",
          "otp"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1",
          "account_last4": "$2",
          "type": "debit",
          "bank": "HDFC Bank"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "hdfc-debit-02",
      "name": "HDFC Bank UPI Debit",
      "priority": 305,
      "match": {
        "sender_pattern": "(?i)HDFC",
        "body_pattern": "(?i)(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+debited\\s+from\\s+a/c\\s+[Xx*]*(\\d{3,4})[\\s\\S]{0,80}?to\\s+VPA\\s+(\\S+)",
        "body_must_not_contain": [
          "OTP",
          "otp"
