    {
      "id": "canara-otp-login-01",
      "name": "Canara Bank Internet Banking OTP",
      "priority": 310,
      "match": {
        "sender_pattern": "(?i)(?:CANBNK|CANBK|CANARA)",
        "body_pattern": "(?i)(\\d{4,8})\\s+is\\s+your\\s+OTP\\s+for\\s+logging\\s+in\\s+to\\s+internet\\s+banking[\\s\\S]{0,80}?Canara\\s+Bank"
      },
      "action": {
        "category": "otp",
        "sub_category": "otp",
        "extract": {
          "otp_code": "$1",
