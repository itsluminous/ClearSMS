{
  "version": "1.0",
  "rules": [
    {
      "id": "canara-debit-01",
      "name": "Canara Bank Account Debit",
      "priority": 300,
      "match": {
        "sender_pattern": "(?i)(?:CANBNK|CANBK|CANARA)",
        "body_pattern": "(?i)(?:your\\s+)?account\\s+[Xx*]*(\\d{3,4})\\s+(?:is\\s+)?debited\\s+(?:with|for)\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)",
        "body_must_not_contain": [
          "OTP",
          "otp"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "account_last4": "$1",
          "amount": "$2",
          "type": "debit",
          "bank": "Canara Bank"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "canara-credit-01",
      "name": "Canara Bank Credit Transaction",
      "priority": 300,
      "match": {
        "sender_pattern": "(?i)(?:CANBNK|CANBK|CANARA)",
        "body_pattern": "(?i)(?:your\\s+)?account\\s+[Xx*]*(\\d{3,4})\\s+(?:is\\s+)?credited\\s+(?:with|for)\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)",
        "body_must_not_contain": [
          "OTP",
          "otp"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "account_last4": "$1",
          "amount": "$2",
