{
  "version": "1.0",
  "rules": [
    {
      "id": "paytm-bank-debit-01",
      "name": "Paytm Payments Bank Debit",
      "priority": 300,
      "match": {
        "sender_pattern": "(?i)(?:PYTMB|PAYTMB|IPAYTM|PAYTM)",
        "body_pattern": "(?i)(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+paid\\s+from\\s+(?:your\\s+)?Paytm\\s+(?:Payments\\s+)?Bank\\s+a/c\\s+[Xx*]*(\\d{3,4})",
        "guards_none": [
          "otp_mention"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1",
          "account_last4": "$2",
          "type": "debit",
          "bank": "Paytm Payments Bank"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "paytm-bank-credit-01",
      "name": "Paytm Payments Bank Credit Transaction",
      "priority": 300,
      "match": {
        "sender_pattern": "(?i)(?:PYTMB|PAYTMB|IPAYTM|PAYTM)",
        "body_pattern": "(?i)(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+(?:received|added)\\s+(?:in|to)\\s+(?:your\\s+)?Paytm\\s+(?:Payments\\s+)?Bank\\s+a/c\\s+[Xx*]*(\\d{3,4})",
        "guards_none": [
          "otp_mention"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1",
          "account_last4": "$2",
          "type": "credit",
          "bank": "Paytm Payments Bank"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "paytm-bank-balance-01",
      "name": "Paytm Payments Bank Balance Alert",
      "priority": 280,
      "match": {
        "sender_pattern": "(?i)(?:PYTMB|PAYTMB|IPAYTM|PAYTM)",
        "body_pattern": "(?i)(?:avl|available)\\s+bal(?:ance)?\\s+(?:in|for)\\s+(?:your\\s+)?a/c\\s+(?:no\\.?\\s*)?[Xx*]*(\\d{3,4})[\\s\\S]{0,60}?is\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)",
        "guards_none": [
          "otp_mention"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "bank_alert",
        "extract": {
          "account_last4": "$1",
          "balance": "$2",
          "bank": "Paytm Payments Bank"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "paytm-bank-card-bill-01",
      "name": "Paytm Payments Bank Credit Card Bill Reminder",
      "priority": 260,
      "match": {
        "sender_pattern": "(?i)(?:PYTMB|PAYTMB|IPAYTM|PAYTM)",
        "body_pattern": "(?i)(?:credit\\s+)?card\\s+(?:no\\.?\\s*)?(?:ending\\s+)?[Xx*]*(\\d{4})[\\s\\S]{0,100}?total\\s+(?:amt|amount)?\\s*due[\\s:]*(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)[\\s\\S]{0,80}?min(?:imum)?\\s+(?:amt|amount)?\\s*due[\\s:]*(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)[\\s\\S]{0,80}?(?:due\\s+by|pay\\s+by|by)\\s+(\\d{1,2}[-/\\s](?:[A-Za-z]{3}|\\d{1,2})[-/\\s]\\d{2,4})"
      },
      "action": {
        "category": "important",
        "sub_category": "bill",
        "extract": {
          "account_last4": "$1",
          "total_due": "$2",
          "min_due": "$3",
          "due_date": "$4",
          "bank": "Paytm Payments Bank"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "paytm-bank-emi-01",
      "name": "Paytm Payments Bank EMI Reminder",
      "priority": 250,
      "match": {
        "sender_pattern": "(?i)(?:PYTMB|PAYTMB|IPAYTM|PAYTM)",
        "body_pattern": "(?i)EMI\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)[\\s\\S]{0,80}?due\\s+on\\s+(\\d{1,2}[-/\\s](?:[A-Za-z]{3}|\\d{1,2})[-/\\s]\\d{2,4})"
      },
      "action": {
        "category": "important",
        "sub_category": "bill",
        "extract": {
          "amount": "$1",
          "due_date": "$2",
          "bank": "Paytm Payments Bank"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    }
  ]
}
