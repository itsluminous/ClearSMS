        "guards_none": [
          "otp_mention"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1",
          "account_last4": "$2",
          "balance": "$3",
          "type": "credit",
          "bank": "Unity SFB"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
