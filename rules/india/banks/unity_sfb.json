{
  "version": "1.0",
  "rules": [
    {
      "id": "unity-neft-debit-01",
      "name": "Unity SFB NEFT Debit With Reference",
      "priority": 332,
      "match": {
        "sender_pattern": "(?i)UNTYBA",
        "body_pattern": "(?i)Rs\\.?\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+debited\\s+from\\s+your\\s+A/c\\s+no\\s+[Xx*\\d]*?(\\d{3,4})\\s+for\\s+NEFT\\s+transaction[\\s\\S]{0,40}?NEFT\\s+Ref\\s+no-?\\s*(\\d{6,16})\\s*Avl\\s+Bal\\s*:?\\s*Rs\\.?\\s*([\\d,]+(?:\\.\\d{1,2})?)",
        "guards_none": [
          "otp_mention"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1",
          "account_last4": "$2",
          "reference": "$3",
          "balance": "$4",
          "type": "debit",
          "bank": "Unity SFB"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "unity-credit-bal-01",
      "name": "Unity SFB Credit With Balance",
