{
  "version": "1.0",
  "rules": [
    {
      "id": "airtel-recharge-01",
      "name": "Airtel Recharge Confirmation",
      "priority": 240,
      "match": {
        "sender_pattern": "(?i)AIRTEL",
        "body_pattern": "(?i)recharge\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s*(?:is|was)?\\s*successful",
        "guards_none": [
          "otp_mention"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "recharge",
        "extract": {
          "amount": "$1",
          "operator": "Airtel"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "airtel-data-balance-01",
      "name": "Airtel Data Balance Alert",
      "priority": 230,
      "match": {
        "sender_pattern": "(?i)AIRTEL",
        "body_pattern": "(?i)data\\s+(?:balance|left|remaining|quota)[\\s\\S]{0,20}?([\\d.]+)\\s*(?:GB|MB)"
      },
      "action": {
        "category": "important",
        "sub_category": "recharge",
        "extract": {
          "data_remaining": "$1",
          "operator": "Airtel"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "airtel-promo-01",
      "name": "Airtel Promotional Offer",
      "priority": 150,
      "match": {
        "sender_pattern": "(?i)AIRTEL",
        "body_pattern": "(?i)(?:special\\s+offer|exciting\\s+offer|best\\s+plans?|unlimited\\s+(?:calls|data)|limited\\s+period|cashback\\s+offer|dhamaka|recharge\\s+now\\s+(?:&|and)\\s+get)"
      },
      "action": {
        "category": "promotional",
        "sub_category": "offer"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "airtel-postpaid-payment-01",
      "name": "Airtel Postpaid Payment Applied",
      "priority": 245,
      "match": {
        "sender_pattern": "(?i)AIRTEL",
        "body_pattern": "(?i)we\\s+have\\s+credited\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+by\\b[\\s\\S]{0,50}?to\\s+your\\s+Airtel\\s+Postpaid"
      },
      "action": {
        "category": "important",
        "sub_category": "recharge",
        "extract": {
          "amount": "$1"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "airtel-bill-due-01",
      "name": "Airtel Bill Payment Due",
      "priority": 244,
      "match": {
        "sender_pattern": "(?i)(?:AIRBIL|AIRTEL)",
        "body_pattern": "(?i)payment\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+is\\s+due\\s+on\\s+([0-9A-Za-z-]{6,12})\\s+for\\s+your\\s+Airtel"
      },
      "action": {
        "category": "important",
        "sub_category": "bill",
        "extract": {
          "total_due": "$1",
          "due_date": "$2"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "airtel-pack-expiry-01",
      "name": "Airtel Pack Expiry Recharge Reminder",
      "priority": 250,
      "match": {
        "sender_pattern": "(?i)(?:AIRTEL|^(?:[A-Z]{2}-)?6500\\d{2}(?:-[SPTG])?$)",
        "body_pattern": "(?i)Your\\s+Airtel\\s+pack\\b[\\s\\S]{0,60}?(?:about\\s+to\\s+expire|has\\s+expired|expires)"
      },
      "action": {
        "category": "important",
        "sub_category": "recharge",
        "extract": {
          "operator": "Airtel"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "airtel-marketing-01",
      "name": "Airtel Marketing Shortcode Blast",
      "priority": 140,
      "match": {
        "sender_pattern": "(?i)^(?:[A-Z]{2}-)?(?:6500\\d{2}|56321)(?:-[SPTG])?$",
        "body_pattern": "(?i)(?:airtel|xstream)"
      },
      "action": {
        "category": "promotional",
        "sub_category": "offer"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "airtel-bill-generated-01",
      "name": "Airtel Bill Generated",
      "priority": 248,
      "match": {
        "sender_pattern": "(?i)(?:AIRBIL|AIRTEL)",
        "body_pattern": "(?i)\\bBill\\s+for\\s+your\\s+Airtel\\b[\\s\\S]{0,60}?\\bhas\\s+been\\s+generated\\b[\\s\\S]{0,20}?Amount\\s+to\\s+be\\s+paid:\\s*(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)"
      },
      "action": {
        "category": "important",
        "sub_category": "bill",
        "extract": {
          "amount": "$1"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "airtel-bill-details-01",
      "name": "Airtel Bill Details / Total Due",
      "priority": 247,
      "match": {
        "sender_pattern": "(?i)(?:AIRBIL|AIRTEL)",
        "body_pattern": "(?i)\\bDetails\\s+of\\s+bill\\s+dated\\b[\\s\\S]{0,60}?Total\\s+Due:\\s*(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)"
      },
      "action": {
        "category": "important",
        "sub_category": "bill",
        "extract": {
          "amount": "$1"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "airtel-bill-due-02",
      "name": "Airtel Bill Due For Payment (dated)",
      "priority": 246,
      "match": {
        "sender_pattern": "(?i)(?:AIRBIL|AIRTEL)",
        "body_pattern": "(?i)\\bbill\\s+dated\\b[\\s\\S]{0,50}?\\bis\\s+due\\s+for\\s+payment\\s+on\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "bill"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "airtel-bill-due-03",
      "name": "Airtel Bill Due For Payment (amount)",
      "priority": 243,
      "match": {
        "sender_pattern": "(?i)(?:AIRBIL|AIRTEL)",
        "body_pattern": "(?i)\\bBill\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+is\\s+due\\s+for\\s+payment\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "bill",
        "extract": {
          "amount": "$1"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "airtel-payment-received-01",
      "name": "Airtel Payment Receipt",
      "priority": 249,
      "match": {
        "sender_pattern": "(?i)(?:AIRBIL|AIRTEL)",
        "body_pattern": "(?i)\\breceived\\s+a\\s+payment\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+for\\s+your\\s+Airtel\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1",
          "type": "debit",
          "merchant": "Airtel"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "airtel-bill-nodue-01",
      "name": "Airtel Bill Generated (nothing due)",
      "priority": 251,
      "match": {
        "sender_pattern": "(?i)(?:AIRBIL|AIRTEL)",
        "body_pattern": "(?i)\\bBill\\s+for\\s+your\\s+Airtel\\b[\\s\\S]{0,60}?\\bhas\\s+been\\s+generated\\s+and\\s+there\\s+is\\s+no\\s+payable\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "bill"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    }
  ]
}