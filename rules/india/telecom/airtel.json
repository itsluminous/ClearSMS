{
  "version": "1.0",
  "rules": [
    {
      "id": "airtel-recharge-01",
      "name": "Airtel Recharge Confirmation",
      "priority": 240,
      "match": {
        "sender_pattern": "(?i)AIRTEL",
        "body_pattern": "(?i)recharge\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s*(?:is|was)?\\s*successful",
        "body_must_not_contain": [
          "OTP",
          "otp"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "recharge",
        "extract": {
          "amount": "$1",
          "operator": "Airtel"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "airtel-data-balance-01",
      "name": "Airtel Data Balance Alert",
      "priority": 230,
      "match": {
        "sender_pattern": "(?i)AIRTEL",
        "body_pattern": "(?i)data\\s+(?:balance|left|remaining|quota)[\\s\\S]{0,20}?([\\d.]+)\\s*(?:GB|MB)"
      },
      "action": {
        "category": "important",
        "sub_category": "recharge",
        "extract": {
          "data_remaining": "$1",
          "operator": "Airtel"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "airtel-promo-01",
      "name": "Airtel Promotional Offer",
      "priority": 150,
      "match": {
        "sender_pattern": "(?i)AIRTEL",
        "body_pattern": "(?i)(?:special\\s+offer|exciting\\s+offer|best\\s+plans?|unlimited\\s+(?:calls|data)|limited\\s+period|cashback\\s+offer|dhamaka|recharge\\s+now\\s+(?:&|and)\\s+get)"
      },
      "action": {
        "category": "promotional",
        "sub_category": "offer"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "airtel-postpaid-payment-01",
      "name": "Airtel Postpaid Payment Applied",
      "priority": 245,
      "match": {
        "sender_pattern": "(?i)AIRTEL",
        "body_pattern": "(?i)we\\s+have\\s+credited\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+by\\b[\\s\\S]{0,50}?to\\s+your\\s+Airtel\\s+Postpaid"
      },
      "action": {
        "category": "important",
        "sub_category": "recharge",
        "extract": {
          "amount": "$1"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "airtel-bill-due-01",
      "name": "Airtel Bill Payment Due",
      "priority": 244,
      "match": {
        "sender_pattern": "(?i)(?:AIRBIL|AIRTEL)",
        "body_pattern": "(?i)payment\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+is\\s+due\\s+on\\s+([0-9A-Za-z-]{6,12})\\s+for\\s+your\\s+Airtel"
      },
      "action": {
        "category": "important",
        "sub_category": "bill",
        "extract": {
          "total_due": "$1",
          "due_date": "$2"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    }
  ]
}
