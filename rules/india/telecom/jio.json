{
  "version": "1.0",
  "rules": [
    {
      "id": "jio-recharge-01",
      "name": "Jio Recharge Confirmation",
      "priority": 240,
      "match": {
        "sender_pattern": "(?i)(?:JIONET|JIOPAY|JIO)",
        "body_pattern": "(?i)recharge\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s*(?:is|was)?\\s*successful",
        "guards_none": [
          "otp_mention"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "recharge",
        "extract": {
          "amount": "$1",
          "operator": "Jio"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "jio-data-balance-01",
      "name": "Jio Data Balance Alert",
      "priority": 230,
      "match": {
        "sender_pattern": "(?i)(?:JIONET|JIOPAY|JIO)",
        "body_pattern": "(?i)data\\s+(?:balance|left|remaining|quota)[\\s\\S]{0,20}?([\\d.]+)\\s*(?:GB|MB)"
      },
      "action": {
        "category": "important",
        "sub_category": "recharge",
        "extract": {
          "data_remaining": "$1",
          "operator": "Jio"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "jio-plan-expiry-01",
      "name": "Jio Plan Expiry Recharge Reminder",
      "priority": 250,
      "match": {
        "sender_pattern": "(?i)(?:JIONET|JIOPAY|JIO)",
        "body_pattern": "(?i)(?:your[^\\n]{0,30}?\\b(?:plan|pack)\\b(?:\\s+(?:for|on)\\s+[^\\n]{0,40}?)?\\s+(?:is\\s+(?:about\\s+to\\s+)?expiring|is\\s+about\\s+to\\s+expire|has\\s+expired|expires|will\\s+expire)\\b|\\bvalidity\\b[^\\n]{0,40}?\\b(?:is\\s+expiring|has\\s+expired|expires|will\\s+expire)\\b)"
      },
      "action": {
        "category": "important",
        "sub_category": "recharge",
        "extract": {
          "operator": "Jio"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-08-19T00:00:00Z"
    },
    {
      "id": "jio-promo-01",
      "name": "Jio Promotional Offer",
      "priority": 150,
      "match": {
        "sender_pattern": "(?i)(?:JIONET|JIOPAY|JIO)",
        "body_pattern": "(?i)(?:special\\s+offer|exciting\\s+offer|best\\s+plans?|unlimited\\s+(?:calls|data)|limited\\s+period|cashback\\s+offer|dhamaka|recharge\\s+now\\s+(?:&|and)\\s+get)"
      },
      "action": {
        "category": "promotional",
        "sub_category": "offer"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    }
  ]
}
