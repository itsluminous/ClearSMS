{
  "version": "1.0",
  "rules": [
    {
      "id": "generic-coupon-01",
      "name": "Coupon/Voucher Blast",
      "priority": 20,
      "match": {
        "body_pattern": "(?i)(?:coupon|voucher)\\s+worth\\b"
      },
      "action": {
        "category": "promotional",
        "sub_category": "offer"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "generic-realestate-promo-01",
      "name": "Real Estate Marketing Blast",
      "priority": 24,
      "match": {
        "body_pattern": "(?i)\\bBHK\\b[\\s\\S]{0,120}?(?:Lacs?|Lakhs?|\\bCr\\b|Call\\s+Now|Price|RERA|s(?:q\\.?\\s?)?ft)"
      },
      "action": {
        "category": "promotional",
        "sub_category": "offer"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    }
  ]
