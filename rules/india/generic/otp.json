{
  "version": "1.0",
  "rules": [
    {
      "id": "generic-otp-01",
      "name": "Generic OTP Extraction (keyword first)",
      "priority": 55,
      "match": {
        "body_pattern": "(?i)(?:otp|code|password|pin)\\s*(?:is|:)?\\s*(\\d{4,8})"
      },
      "action": {
        "category": "otp",
        "extract": {
          "otp_code": "$1"
        },
        "notification": "otp_popup"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "generic-otp-02",
      "name": "Generic OTP Extraction (digits first)",
      "priority": 54,
      "match": {
        "body_pattern": "(?i)(?<!\\d)(\\d{4,8})\\s+is\\s+(?:your|the)\\s+(?:otp|one[\\s-]?time|verification|code|password)"
      },
      "action": {
        "category": "otp",
        "extract": {
          "otp_code": "$1"
        },
        "notification": "otp_popup"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "generic-otp-03",
      "name": "Generic OTP Extraction (use/enter)",
      "priority": 53,
      "match": {
        "body_pattern": "(?i)(?:use|enter)\\s+(?:otp\\s+)?(\\d{4,8})\\s+(?:to|for|as)"
      },
      "action": {
        "category": "otp",
        "extract": {
          "otp_code": "$1"
        },
        "notification": "otp_popup"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "generic-otp-04",
      "name": "Contextual 6-digit OTP",
      "priority": 52,
      "match": {
        "body_pattern": "(?i)(?=[\\s\\S]*(?:verif|authenticat|one[\\s-]?time|login|sign[\\s-]?in))[\\s\\S]*?(?<!\\d)(\\d{6})(?!\\d)"
      },
      "action": {
        "category": "otp",
        "extract": {
          "otp_code": "$1"
        },
        "notification": "otp_popup"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "generic-otp-05",
      "name": "Branded OTP (digits first)",
      "priority": 51,
      "match": {
        "body_pattern": "(?i)(?<!\\d)(\\d{4,8})\\s+is\\s+your\\s+(?:\\w+[ .-]){0,3}?otp"
      },
      "action": {
        "category": "otp",
        "extract": {
          "otp_code": "$1"
        },
        "notification": "otp_popup"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    }
  ]
}
