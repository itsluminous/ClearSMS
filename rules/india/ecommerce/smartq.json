{
  "version": "1.0",
  "rules": [
    {
      "id": "smartq-refund-01",
      "name": "SmartQ Refund Initiated",
      "priority": 315,
      "match": {
        "sender_pattern": "(?i)BLTLAB",
        "body_pattern": "(?i)refund\\s+for\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s*/?-?\\s+has\\s+been\\s+initiated[\\s\\S]{0,100}?SmartQ"
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1",
          "type": "credit",
          "merchant": "SmartQ"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    }
  ]
