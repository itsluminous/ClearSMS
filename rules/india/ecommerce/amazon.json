{
  "version": "1.0",
  "rules": [
    {
      "id": "amazon-delivery-01",
      "name": "Amazon Order Delivery Update",
      "priority": 220,
      "match": {
        "sender_pattern": "(?i)(?:AMAZON|AMZN)",
        "body_pattern": "(?i)(?:order|package|parcel|shipment)[\\s\\S]{0,80}?(?:shipped|dispatched|out\\s+for\\s+delivery|delivered|arriving\\s+(?:today|tomorrow|soon)|on\\s+the\\s+way)"
      },
      "action": {
        "category": "important",
        "sub_category": "delivery",
        "extract": {
          "merchant": "Amazon"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "amazon-promo-01",
      "name": "Amazon Promotional Offer",
      "priority": 150,
      "match": {
        "sender_pattern": "(?i)(?:AMAZON|AMZN)",
        "body_pattern": "(?i)(?:\\d{1,2}%\\s*off|sale\\s+is\\s+live|mega\\s+sale|big\\s+billion|great\\s+indian|flat\\s+\\d+|coupon|promo\\s+code|discount|deal\\s+of\\s+the\\s+day|cashback)"
      },
      "action": {
        "category": "promotional",
        "sub_category": "offer"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "amazon-prime-01",
      "name": "Amazon Prime Membership Renewal",
      "priority": 221,
      "match": {
        "body_pattern": "(?i)prime\\s+membership[\\s\\S]{0,60}?(?:renew|expired)",
        "body_must_contain": [
          "amazon"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "bill"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "amazon-otp-01",
      "name": "Amazon Sign-In OTP",
      "priority": 230,
      "match": {
        "body_pattern": "(?i)(\\d{4,8})\\s+is\\s+your\\s+Amazon\\s+OTP"
      },
      "action": {
        "category": "otp",
        "sub_category": "otp",
        "extract": {
          "otp_code": "$1"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "amazon-return-pickup-01",
      "name": "Amazon Return Pickup Scheduled",
      "priority": 219,
      "match": {
        "body_pattern": "(?i)your\\s+return\\s+pickup\\s+for\\s+\\d{3}-\\d{7}-\\d{7}\\s+is\\s+scheduled"
      },
      "action": {
        "category": "important",
        "sub_category": "delivery"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "amazon-delivered-02",
      "name": "Amazon Order Delivered",
      "priority": 219,
      "match": {
        "body_pattern": "(?i)your\\s+Amazon\\.in\\s+order\\s+\\d{3}-\\d{7}-\\d{7}\\s+has\\s+been\\s+delivered"
      },
      "action": {
        "category": "important",
        "sub_category": "delivery"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "amazon-agent-delivery-01",
      "name": "Amazon Delivery Agent Update",
      "priority": 218,
      "match": {
        "body_pattern": "(?i)(?:\\bAmzAgent\\b|Amazon\\s+Delivery\\s+Associate)"
      },
      "action": {
        "category": "important",
        "sub_category": "delivery"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "amazon-refund-issued-01",
      "name": "Amazon Refund Issued",
      "priority": 217,
      "match": {
        "body_pattern": "(?i)refund\\s+issued:\\s*amount\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)",
        "body_must_contain": [
          "amzn.in"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1",
          "type": "credit",
          "merchant": "Amazon"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "amazon-install-status-01",
      "name": "Amazon Order Installation Status",
      "priority": 212,
      "match": {
        "body_pattern": "(?i)install(?:ation|ed)?\\b[\\s\\S]{0,80}?\\b\\d{3}-\\d{7}-\\d{7}\\b|\\b\\d{3}-\\d{7}-\\d{7}\\b[\\s\\S]{0,60}?\\binstall(?:ation|ed)?\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "general",
        "extract": {
          "merchant": "Amazon"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-08-12T00:00:00Z"
    },
    {
      "id": "amazon-job-application-01",
      "name": "Amazon Job Application Status",
      "priority": 214,
      "match": {
        "body_pattern": "(?i)status\\s+of\\s+your\\s+Amazon\\s+job\\s+application\\s+has\\s+changed"
      },
      "action": {
        "category": "important",
        "sub_category": "general"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-08-12T00:00:00Z"
    },
    {
      "id": "amazon-images-required-01",
      "name": "Amazon Requires Images Upload",
      "priority": 214,
      "match": {
        "body_pattern": "(?i)(?:Amazon\\s+requires\\s+images:|upload\\s+the\\s+images\\s+required\\s+by\\s+Amazon\\b)"
      },
      "action": {
        "category": "important",
        "sub_category": "general"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-08-12T00:00:00Z"
    },
    {
      "id": "amazon-return-cancelled-01",
      "name": "Amazon Return Pickup Cancelled",
      "priority": 215,
      "match": {
        "body_pattern": "(?i)Pickup\\s+Cancelled:\\s*Your\\s+return\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "delivery",
        "extract": {
          "merchant": "Amazon"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-08-12T00:00:00Z"
    },
    {
      "id": "amazon-service-completed-01",
      "name": "Amazon Home Service Completed",
      "priority": 213,
      "match": {
        "body_pattern": "(?i)\\bis\\s+completed\\s+as\\s+per\\s+technician\\b",
        "body_must_contain": [
          "amzn.in"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "general",
        "extract": {
          "merchant": "Amazon"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-08-12T00:00:00Z"
    },
    {
      "id": "amazon-return-reminder-01",
      "name": "Amazon Return Pickup Reminder",
      "priority": 215,
      "match": {
        "body_pattern": "(?i)Pickup\\s+reminder:\\s*Your\\s+return\\s+pick\\s*up\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "delivery",
        "extract": {
          "merchant": "Amazon"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-08-12T00:00:00Z"
    },
    {
      "id": "amazon-order-cancelled-01",
      "name": "Amazon Order Cancelled",
      "priority": 215,
      "match": {
        "body_pattern": "(?i)Order\\s+Cancelled:\\s*Your\\s+Amazon[^\\n]{0,15}?\\border\\s+\\d{3}-\\d{7}-\\d{7}"
      },
      "action": {
        "category": "important",
        "sub_category": "general",
        "extract": {
          "merchant": "Amazon"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-08-12T00:00:00Z"
    },
    {
      "id": "amazon-order-confirmed-01",
      "name": "Amazon Order Placed Confirmation",
      "priority": 216,
      "match": {
        "body_pattern": "(?i)Confirmed:\\s*Your\\s+Amazon\\.in\\s+order\\s+\\d{3}-\\d{7}-\\d{7}\\s+is\\s+successfully\\s+placed"
      },
      "action": {
        "category": "important",
        "sub_category": "delivery",
        "extract": {
          "merchant": "Amazon"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-08-12T00:00:00Z"
    },
    {
      "id": "amazon-return-item-cancelled-01",
      "name": "Amazon Return Item Cancelled / Returned",
      "priority": 213,
      "match": {
        "body_pattern": "(?i)Cancelled:[^\\n]{0,80}?\\bis\\s+being\\s+returned\\s+to\\s+us",
        "body_must_contain": [
          "amzn.in"
        ]
      },
      "action": {
        "category": "important",
        "sub_category": "delivery",
        "extract": {
          "merchant": "Amazon"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-08-12T00:00:00Z"
    }
  ]
}
