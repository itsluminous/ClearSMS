{
  "version": "1.0",
  "rules": [
    {
      "id": "justdial-otp-01",
      "name": "Justdial Login OTP",
      "priority": 330,
      "match": {
        "sender_pattern": "(?i)JUSTDL",
        "body_pattern": "(?i)OTP\\s+(\\d{4,8})\\s+DO\\s+NOT\\s+SHARE\\s+your\\s+Justdial"
      },
      "action": {
        "category": "otp",
        "sub_category": "otp",
        "extract": {
          "otp_code": "$1"
        },
        "notification": "otp_popup"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    }
  ]
}
