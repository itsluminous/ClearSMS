{
  "version": "1.0",
  "rules": [
    {
      "id": "ekart-tracking-01",
      "name": "Ekart Logistics Shipment Tracking",
      "priority": 220,
      "match": {
        "sender_pattern": "(?i)(?:EKART|EKTLOG)",
        "body_pattern": "(?i)(?:AWB|tracking|consignment|shipment)\\s*(?:no\\.?|id|number)?[\\s:#-]*([A-Za-z0-9]{8,20})"
      },
      "action": {
        "category": "important",
        "sub_category": "delivery",
        "extract": {
          "tracking_id": "$1",
          "courier": "Ekart Logistics"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "ekart-delivery-01",
      "name": "Ekart Logistics Delivery Status Update",
      "priority": 215,
      "match": {
        "sender_pattern": "(?i)(?:EKART|EKTLOG)",
        "body_pattern": "(?i)(?:out\\s+for\\s+delivery|will\\s+be\\s+delivered|has\\s+been\\s+delivered|arriving\\s+today|delivery\\s+(?:attempted|rescheduled))"
      },
      "action": {
        "category": "important",
        "sub_category": "delivery",
        "extract": {
          "courier": "Ekart Logistics"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "ekart-delivered-02",
      "name": "Ekart Package Delivered",
      "priority": 214,
      "match": {
        "sender_pattern": "(?i)(?:EKART|EKTLOG)",
        "body_pattern": "(?i)\\bwas\\s+delivered\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "delivery"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    }
  ]
}
