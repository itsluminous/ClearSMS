{
  "version": "1.0",
  "rules": [
    {
      "id": "irctc-journey-01",
      "name": "IRCTC Journey Ticket (PNR/TRN/DOJ)",
      "priority": 322,
      "match": {
        "sender_pattern": "(?i)IRCTC",
        "body_pattern": "(?i)\\bPNR[:\\s]*(\\d{10})\\s*,\\s*TRN[:\\s]*(\\d{3,5})\\s*,\\s*DOJ[:\\s]*(\\d{1,2}-\\d{1,2}-\\d{2,4})[\\s\\S]{0,20}?\\b([A-Za-z]{2,6}-[A-Za-z]{2,6})\\s*,\\s*DP[:\\s]*(\\d{1,2}:\\d{2})"
      },
      "action": {
        "category": "important",
        "sub_category": "travel",
        "extract": {
          "pnr": "$1",
          "train": "$2",
          "journey_date": "$3",
          "route": "$4",
          "departure_time": "$5"
        },
        "extract_types": {
          "journey_date": "date"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-08-12T00:00:00Z"
    },
    {
      "id": "irctc-journey-02",
      "name": "IRCTC/CRIS compact journey ticket (PNR-/Trn:/Dt:/Frm-to)",
      "priority": 323,
      "match": {
        "sender_pattern": "(?i)IRCTC",
        "body_pattern": "(?i)\\bPNR[-:\\s]*(\\d{10})[\\s\\S]{0,24}?\\bTrn[-:\\s]*(\\d{3,5})[\\s\\S]{0,24}?\\bDt[-:\\s]*(\\d{1,2}-\\d{1,2}-\\d{2,4})[\\s\\S]{0,24}?\\bFrm\\s+([A-Z]{2,6})\\s+to\\s+([A-Z]{2,6})"
      },
      "action": {
        "category": "important",
        "sub_category": "travel",
        "extract": {
          "pnr": "$1",
          "train": "$2",
          "journey_date": "$3",
          "route": "$4 to $5"
        },
        "extract_types": {
          "journey_date": "date"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-08-23T00:00:00Z"
    },
    {
      "id": "irctc-cancel-01",
      "name": "IRCTC Ticket Cancellation",
      "priority": 321,
      "match": {
        "sender_pattern": "(?i)IRCTC",
        "body_pattern": "(?i)PNR[\\s:]*(\\d{10})\\s+ticket\\s+cancelled"
      },
      "action": {
        "category": "important",
        "extract": {
          "pnr": "$1"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "irctc-booking-01",
      "name": "IRCTC Ticket Booking Confirmation",
      "priority": 320,
      "match": {
        "sender_pattern": "(?i)IRCTC",
        "body_pattern": "(?i)PNR[\\s:]*(\\d{10})[\\s\\S]{0,20}?TRN"
      },
      "action": {
        "category": "important",
        "extract": {
          "pnr": "$1"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "irctc-refund-01",
      "name": "IRCTC Refund Update",
      "priority": 315,
      "match": {
        "sender_pattern": "(?i)IRCTC",
        "body_pattern": "(?i)\\brefund(?:ed)?\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "type": "credit"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "irctc-info-01",
      "name": "IRCTC Service Update",
      "priority": 200,
      "match": {
        "sender_pattern": "(?i)IRCTC",
        "guards_none": [
          "otp_mention"
        ]
      },
      "action": {
        "category": "important"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    }
  ]
}
