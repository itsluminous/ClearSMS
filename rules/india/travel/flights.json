{
  "version": "1.0",
  "rules": [
    {
      "id": "flight-seat-01",
      "name": "Flight Seat Assignment",
      "priority": 262,
      "match": {
        "body_pattern": "(?i)\\bassigned\\s+seat\\s+\\d{1,3}[A-Z]\\b[\\s\\S]{0,80}?\\bflight\\b"
      },
      "action": {
        "category": "informational",
        "sub_category": "travel"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "flight-boarding-01",
      "name": "Flight Boarding / Gate Notice",
      "priority": 261,
      "match": {
        "body_pattern": "(?i)\\bflight\\b[\\s\\S]{0,60}?\\b(?:boards\\s+at\\s+gate|gate\\s+closes|boarding\\s+(?:gate|at))\\b"
      },
      "action": {
        "category": "informational",
        "sub_category": "travel"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "flight-pnr-01",
      "name": "Airline PNR / Check-in Notice",
      "priority": 300,
      "match": {
        "sender_pattern": "(?i)(?:INDIGO|AKASAA|GOFRST|SPICEJ|AIRIND|AIRVIS|VSTARA)",
        "body_pattern": "(?i)\\bPNR\\b[\\s\\S]{0,60}?\\b(?:flight|departure|web\\s*check-?in|boarding)\\b|\\bflight\\b[\\s\\S]{0,60}?\\bPNR\\b"
      },
      "action": {
        "category": "informational",
        "sub_category": "travel"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    }
  ]
}
