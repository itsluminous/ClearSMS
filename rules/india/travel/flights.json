{
  "version": "1.0",
  "rules": [
    {
      "id": "flight-seat-01",
      "name": "Flight Seat Assignment",
      "priority": 262,
      "match": {
        "body_pattern": "(?i)\\bassigned\\s+seat\\s+\\d{1,3}[A-Z]\\b[\\s\\S]{0,80}?\\bflight\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "travel"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "flight-boarding-01",
      "name": "Flight Boarding / Gate Notice",
      "priority": 261,
      "match": {
        "body_pattern": "(?i)\\bflight\\b[\\s\\S]{0,60}?\\b(?:boards\\s+at\\s+gate|gate\\s+closes|boarding\\s+(?:gate|at))\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "travel"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "flight-pnr-01",
      "name": "Airline PNR / Check-in Notice",
      "priority": 300,
      "match": {
        "sender_pattern": "(?i)(?:INDIGO|AKASAA|GOFRST|SPICEJ|AIRIND|AIRVIS|VSTARA)",
        "body_pattern": "(?i)\\bPNR\\b[\\s\\S]{0,60}?\\b(?:flight|departure|web\\s*check-?in|boarding)\\b|\\bflight\\b[\\s\\S]{0,60}?\\bPNR\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "travel"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "flight-booking-pnr-01",
      "name": "Flight Booking Confirmed (PNR)",
      "priority": 302,
      "match": {
        "sender_pattern": "(?i)(?:INDIGO|AKASAA|AKASA|GOFRST|SPICEJ|AIRIND|AIRVIS|VSTARA)",
        "body_pattern": "(?i)\\bconfirm\\s+(?:your|the)\\s+booking\\s+under\\s+PNR\\s*[-:]?\\s*([A-Z0-9]{5,8})\\b(?:,\\s*(\\d{1,2}(?:[\\s/-][A-Za-z]{3}[\\s/-]|[-/]\\d{1,2}[-/])\\d{2,4}))?(?:,\\s*from\\s+([A-Za-z0-9() ]{2,20}?\\s+to\\s+[A-Za-z0-9()]{2,10}))?(?:,\\s*([A-Z0-9]{2}\\s?-?\\s?\\d{2,4}))?(?:\\s+at\\s+(\\d{1,2}[:.]\\d{2}))?"
      },
      "action": {
        "category": "important",
        "sub_category": "travel",
        "extract": {
          "pnr": "$1",
          "journey_date": "$2",
          "route": "$3",
          "flight": "$4",
          "departure_time": "$5"
        },
        "extract_types": {
          "journey_date": "date"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "flight-booking-pnr-02",
      "name": "Flight Booking Confirmed (PNR trailing)",
      "priority": 301,
      "match": {
        "sender_pattern": "(?i)(?:INDIGO|AKASAA|AKASA|GOFRST|SPICEJ|AIRIND|AIRVIS|VSTARA)",
        "body_pattern": "(?i)\\bhappy\\s+to\\s+confirm\\s+your\\s+booking\\b[.,\\s]{0,4}PNR\\s*[-:]?\\s*([A-Z0-9]{5,8})\\b(?:,\\s*(\\d{1,2}(?:[\\s/-][A-Za-z]{3}[\\s/-]|[-/]\\d{1,2}[-/])\\d{2,4}))?(?:,\\s*from\\s+([A-Za-z0-9() ]{2,20}?\\s+to\\s+[A-Za-z0-9()]{2,10}))?(?:,\\s*([A-Z0-9]{2}\\s?-?\\s?\\d{2,4}))?(?:\\s+at\\s+(\\d{1,2}[:.]\\d{2}))?"
      },
      "action": {
        "category": "important",
        "sub_category": "travel",
        "extract": {
          "pnr": "$1",
          "journey_date": "$2",
          "route": "$3",
          "flight": "$4",
          "departure_time": "$5"
        },
        "extract_types": {
          "journey_date": "date"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "flight-booking-route-doj-01",
      "name": "Flight Booking Confirmed (route and journey date)",
      "priority": 304,
      "match": {
        "sender_pattern": "(?i)(?:INDIGO|AKASAA|AKASA|GOFRST|SPICEJ|AIRIND|AIRVIS|VSTARA)",
        "body_pattern": "(?i)\\b(?:booking|ticket)\\s+(?:is\\s+|stands\\s+)?confirmed\\b[\\s\\S]{0,60}?\\bPNR[\\s:.-]{1,3}([A-Z0-9]{5,8})\\b[,.\\s]+([A-Z]{3}\\s?-\\s?[A-Z]{3})\\b[,.\\s]+(\\d{1,2}(?:[\\s/-][A-Za-z]{3}[\\s/-]|[-/]\\d{1,2}[-/])\\d{2,4})(?:,?\\s*(\\d{1,2}[:.]\\d{2}))?"
      },
      "action": {
        "category": "important",
        "sub_category": "travel",
        "extract": {
          "pnr": "$1",
          "route": "$2",
          "journey_date": "$3",
          "departure_time": "$4"
        },
        "extract_types": {
          "journey_date": "date"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-08-16T00:00:00Z"
    },
    {
      "id": "flight-booking-generic-01",
      "name": "Flight Booking Confirmed (no PNR)",
      "priority": 258,
      "match": {
        "sender_pattern": "(?i)(?:INDIGO|AKASAA|AKASA|GOFRST|SPICEJ|AIRIND|AIRVIS|VSTARA)",
        "body_pattern": "(?i)\\bconfirm\\s+your\\s+booking\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "travel"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "flight-itinerary-pnr-01",
      "name": "Flight Itinerary / Check-in Reminder",
      "priority": 303,
      "match": {
        "sender_pattern": "(?i)(?:INDIGO|AKASAA|AKASA|GOFRST|SPICEJ|AIRIND|AIRVIS|VSTARA)",
        "body_pattern": "(?i)\\bPNR\\s+is\\s+([A-Z0-9]{5,8})\\s*-(?:\\s*([A-Z0-9]{2}\\s?-?\\s?\\d{2,4}),\\s*(\\d{1,2}\\s?[A-Za-z]{3}(?:\\s?\\d{2,4})?),\\s*([A-Za-z0-9()]{2,12}-[A-Za-z0-9()]{2,12})(?:\\s+(\\d{4}|\\d{1,2}[:.]\\d{2}))?)?"
      },
      "action": {
        "category": "important",
        "sub_category": "travel",
        "extract": {
          "pnr": "$1",
          "flight": "$2",
          "journey_date": "$3",
          "route": "$4",
          "departure_time": "$5"
        },
        "extract_types": {
          "journey_date": "date"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "flight-itinerary-status-01",
      "name": "Flight Itinerary Confirmed / Modified",
      "priority": 299,
      "match": {
        "sender_pattern": "(?i)(?:INDIGO|AKASAA|AKASA|GOFRST|SPICEJ|AIRIND|AIRVIS|VSTARA)",
        "body_pattern": "(?i)\\btravel\\s+from\\b[\\s\\S]{0,50}?\\bPNR\\s+([A-Z0-9]{5,8})\\b,?\\s+(?:is\\s+confirmed|has\\s+been\\s+modified|is\\s+cancelled|stands\\s+cancelled)"
      },
      "action": {
        "category": "important",
        "sub_category": "travel",
        "extract": {
          "pnr": "$1"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "flight-checkin-done-01",
      "name": "Flight Check-in Complete / Boarding Pass",
      "priority": 264,
      "match": {
        "sender_pattern": "(?i)(?:INDIGO|AKASAA|AKASA|GOFRST|SPICEJ|AIRIND|AIRVIS|VSTARA)",
        "body_pattern": "(?i)\\bthank\\s+you\\s+for\\s+checking\\s+in\\s+online\\b|\\bweb\\s+check-?in\\s+for\\s+flight\\b[\\s\\S]{0,60}?\\bsuccessfully\\s+complete\\b|\\bcheck-?in\\s+for\\s+your\\b[\\s\\S]{0,30}?\\bflight\\b[\\s\\S]{0,40}?\\bconfirmed\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "travel"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "flight-baggage-01",
      "name": "Flight Baggage Checked In / Belt",
      "priority": 263,
      "match": {
        "sender_pattern": "(?i)(?:INDIGO|AKASAA|AKASA|GOFRST|SPICEJ|AIRIND|AIRVIS|VSTARA)",
        "body_pattern": "(?i)\\bchecked-?in\\s+baggage\\b[\\s\\S]{0,60}?\\bbelt\\s+no\\b|\\bbaggage\\s+for\\b[\\s\\S]{0,40}?\\bflight\\b[\\s\\S]{0,60}?\\bchecked\\s+in\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "travel"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "flight-reschedule-01",
      "name": "Flight Rescheduled / Departure Change",
      "priority": 260,
      "match": {
        "sender_pattern": "(?i)(?:INDIGO|AKASAA|AKASA|GOFRST|SPICEJ|AIRIND|AIRVIS|VSTARA)",
        "body_pattern": "(?i)\\bbooking\\s+ref\\b[\\s\\S]{0,80}?\\bis\\s+rescheduled\\b|\\bflight\\b[\\s\\S]{0,80}?\\bwill\\s+now\\s+depart\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "travel"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "flight-gate-change-01",
      "name": "Flight Gate Change Notice",
      "priority": 257,
      "match": {
        "body_pattern": "(?i)\\bgate\\s+has\\s+changed\\s+for\\s+your\\s+flight\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "travel"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "flight-refund-initiated-01",
      "name": "Airline Refund Initiated",
      "priority": 305,
      "match": {
        "sender_pattern": "(?i)(?:INDIGO|AKASAA|AKASA|GOFRST|SPICEJ|AIRIND|AIRVIS|VSTARA)",
        "body_pattern": "(?i)\\brefund\\b[\\s\\S]{0,40}?\\bPNR\\s+([A-Z0-9]{5,8})\\b[\\s\\S]{0,40}?\\binitiated\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "pnr": "$1",
          "type": "credit"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-28T00:00:00Z"
    },
    {
      "id": "vistara-boarding-pass-01",
      "name": "Vistara Boarding Pass Link",
      "priority": 300,
      "match": {
        "body_pattern": "(?i)fly\\.airvistara\\.com/ssci/bp"
      },
      "action": {
        "category": "important",
        "sub_category": "travel"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-08-12T00:00:00Z"
    },
    {
      "id": "tripsource-flight-update-01",
      "name": "TripSource Flight Status Update",
      "priority": 265,
      "match": {
        "body_pattern": "(?i)TripSource:\\s*Your\\s+flight"
      },
      "action": {
        "category": "important",
        "sub_category": "travel"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-08-12T00:00:00Z"
    },
    {
      "id": "flight-cancelled-refund-01",
      "name": "Airline Cancellation Refund Notice",
      "priority": 259,
      "match": {
        "body_pattern": "(?i)\\bflight\\s+[A-Z]{3}-[A-Z]{3}\\s+\\(PNR:?\\s*([A-Z0-9]{5,8})\\)\\s+was\\s+cancelled\\s+by\\s+the\\s+airline[^\\n]{0,20}?\\s*Refund\\s+of\\s+Rs\\.?\\s*([\\d,]+(?:\\.\\d{1,2})?)"
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "pnr": "$1",
          "amount": "$2",
          "type": "credit"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-08-12T00:00:00Z"
    }
  ]
}