{
  "version": "1.0",
  "rules": [
    {
      "id": "cowin-appointment-01",
      "name": "CoWIN Vaccination Appointment",
      "priority": 270,
      "match": {
        "sender_pattern": "(?i).*(?:COWIN|NHPSMS).*",
        "body_pattern": "(?i)[\\s\\S]*(?:vaccin|dose)[\\s\\S]{0,80}?(?:scheduled|confirmed|successful|completed)[\\s\\S]*"
      },
      "action": {
        "category": "important",
        "sub_category": "government"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "cowin-certificate-01",
      "name": "CoWIN Vaccination Certificate",
      "priority": 270,
      "match": {
        "sender_pattern": "(?i).*(?:COWIN|NHPSMS).*",
        "body_pattern": "(?i)[\\s\\S]*(?:vaccination\\s+)?certificate[\\s\\S]{0,60}?(?:download|available|generated)[\\s\\S]*"
      },
      "action": {
        "category": "important",
        "sub_category": "government"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    }
  ]
}
