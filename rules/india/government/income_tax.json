{
  "version": "1.0",
  "rules": [
    {
      "id": "income-tax-refund-01",
      "name": "Income Tax Department Income Tax Refund",
      "priority": 270,
      "match": {
        "sender_pattern": "(?i)(?:ITDEPT|ITDEFL|INCTAX)",
        "body_pattern": "(?i)(?:income\\s+tax\\s+)?refund\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)[\\s\\S]{0,60}?(?:credited|processed|issued)"
      },
      "action": {
        "category": "important",
        "sub_category": "government",
        "extract": {
          "amount": "$1"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "income-tax-itr-status-01",
      "name": "Income Tax Department Income Tax Return Status",
      "priority": 270,
      "match": {
        "sender_pattern": "(?i)(?:ITDEPT|ITDEFL|INCTAX)",
        "body_pattern": "(?i)(?:ITR|income\\s+tax\\s+return)[\\s\\S]{0,80}?(?:filed|verified|processed|e-?verif)"
      },
      "action": {
        "category": "important",
        "sub_category": "government"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "itd-challan-01",
      "name": "Income Tax Challan Payment",
      "priority": 272,
      "match": {
        "sender_pattern": "(?i)ITD",
        "body_pattern": "(?i)challan\\s+payment\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s+against\\s+CRN"
      },
      "action": {
        "category": "important",
        "sub_category": "transaction",
        "extract": {
          "amount": "$1",
          "type": "debit",
          "merchant": "Income Tax Department"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "itd-tds-summary-01",
      "name": "Income Tax Dept Quarterly / Cumulative TDS Summary",
      "priority": 272,
      "match": {
        "sender_pattern": "(?i)(?:ITDEPT|ITDEFL|ITDCPC|INCTAX)",
        "body_pattern": "(?i)\\b(?:total|cumulative)\\s+TDS\\b[^\\n]{0,160}?\\b(?:Qtr|quarter|FY|F\\.?Y\\.?)\\b"
      },
      "action": {
        "category": "important",
        "sub_category": "government"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-08-18T00:00:00Z"
    }
  ]
}
