{
  "version": "1.0",
  "rules": [
    {
      "id": "epfo-contribution-01",
      "name": "EPFO EPF Contribution Credited",
      "priority": 270,
      "match": {
        "sender_pattern": "(?i)(?:EPFOHO|EPFO)",
        "body_pattern": "(?i)(?:PF|EPF)\\s+contribution\\s+of\\s+(?:INR|Rs\\.?|\\u20b9)\\s*([\\d,]+(?:\\.\\d{1,2})?)"
      },
      "action": {
        "category": "important",
        "sub_category": "government",
        "extract": {
          "amount": "$1"
        }
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    },
    {
      "id": "epfo-claim-01",
      "name": "EPFO EPF Claim Status",
      "priority": 270,
      "match": {
        "sender_pattern": "(?i)(?:EPFOHO|EPFO)",
        "body_pattern": "(?i)(?:claim|withdrawal)[\\s\\S]{0,60}?(?:settled|approved|received|under\\s+process)"
      },
      "action": {
        "category": "important",
        "sub_category": "government"
      },
      "contributed_by": "clearsms",
      "created_at": "2026-07-27T00:00:00Z"
    }
  ]
}
